<div class="task-panel-dark">
  <div class="task-panel-dark__header">
    <div>
      <h3 class="task-panel-dark__title">Team Hours</h3>
      <p class="text-muted small mb-0">
        <%= @hours_report.dates.first.strftime("%d %b") %> – <%= @hours_report.dates.last.strftime("%d %b %Y") %>
      </p>
    </div>
    <div class="task-panel-dark__controls">
      <div class="task-filter-pills">
        <%= link_to "Week", dashboard_tasks_path(tab: "team_hours", period: "week", week_start: @week_start),
              class: "task-filter-pill #{'active' if @period == 'week'}" %>
        <%= link_to "Month", dashboard_tasks_path(tab: "team_hours", period: "month", week_start: @week_start),
              class: "task-filter-pill #{'active' if @period == 'month'}" %>
      </div>
      <%= link_to dashboard_tasks_path(tab: "team_hours", period: @period, week_start: @week_start - 7.days),
            class: "btn btn-outline-premium btn-premium btn-sm", "aria-label": "Previous week" do %>
        <i class="fa-solid fa-chevron-left"></i>
      <% end %>
      <%= link_to dashboard_tasks_path(tab: "team_hours", period: @period, week_start: @week_start + 7.days),
            class: "btn btn-outline-premium btn-premium btn-sm", "aria-label": "Next week" do %>
        <i class="fa-solid fa-chevron-right"></i>
      <% end %>
      <%= link_to "Download CSV", export_tasks_path(report: "weekly_timing", format: :csv, period: @period, week_start: @week_start),
            class: "btn btn-outline-premium btn-premium btn-sm" %>
      <%= link_to "Download Excel", export_tasks_path(report: "monthly_stats", format: :xlsx, period: @period, week_start: @week_start),
            class: "btn btn-outline-premium btn-premium btn-sm" %>
    </div>
  </div>

  <% if @hours_report.executives.empty? %>
    <div class="task-empty-state">
      <i class="fa-solid fa-user-group"></i>
      <p>No executives in this department yet. Add them in Settings to track their hours.</p>
    </div>
  <% else %>
    <div class="hours-legend">
      <span><span class="hours-legend__key" style="background:#1c1917"></span>Logged on tasks</span>
      <span><span class="hours-legend__key" style="background:#d6d3d1"></span>Clocked in</span>
      <span><span class="hours-legend__key" style="background:#FEF3C7"></span>Untracked — clocked in, not on a task</span>
    </div>

    <div class="task-panel-dark__body">
      <div class="table-responsive">
        <table class="table align-middle mb-0 hours-table">
          <thead>
            <tr>
              <th class="hours-name">Executive</th>
              <% @hours_report.columns(@period).each do |label, days| %>
                <th class="text-center">
                  <%= label %>
                  <span><%= days.one? ? days.first.strftime("%a") : "#{days.size} days" %></span>
                </th>
              <% end %>
              <th class="text-center hours-total">Total</th>
              <th class="text-center">Untracked</th>
            </tr>
          </thead>
          <tbody>
            <% @hours_report.executives.each do |executive| %>
              <tr>
                <td class="hours-name"><%= executive.name %></td>
                <% @hours_report.columns(@period).each do |_label, days| %>
                  <% cell = @hours_report.bucket(executive.id, days) %>
                  <td class="text-center <%= 'hours-cell--empty' if cell[:task_seconds].zero? && cell[:attendance_seconds].zero? %>">
                    <div class="hours-cell__task"><%= hours_label(cell[:task_seconds]) %></div>
                    <div class="hours-cell__clock"><%= hours_label(cell[:attendance_seconds]) %></div>
                  </td>
                <% end %>
                <% totals = @hours_report.totals_for(executive.id) %>
                <td class="text-center hours-total <%= 'hours-cell--empty' if totals[:task_seconds].zero? %>">
                  <div class="hours-cell__task"><%= hours_label(totals[:task_seconds]) %></div>
                  <div class="hours-cell__clock"><%= hours_label(totals[:attendance_seconds]) %></div>
                </td>
                <td class="text-center">
                  <span class="hours-gap <%= 'hours-gap--flag' if totals[:gap_seconds] >= 3600 %>">
                    <%= hours_label(totals[:gap_seconds]) %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
