<div class="modal fade tm-modal" id="tm-import-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <form data-tm-form data-tm-url="<%= import_tasks_path %>" data-tm-method="POST">
        <div class="modal-header">
          <h2 class="modal-title">Import tasks from a CSV</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="tm-alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><span class="tm-alert__text"></span></div>

          <p class="tm-muted">
            Your file needs these columns:
            <code>Key, Title, Description, Parent, Assignee Email, Task Type, Priority, Due Date, SLA Minutes</code>.
            To nest a subtask, put its parent row's <code>Key</code> in its <code>Parent</code> column.
            Up to 1,000 rows at a time.
          </p>

          <div class="tm-field">
            <label class="tm-field__label" for="tm-import-file">CSV file</label>
            <input type="file" name="file" id="tm-import-file" accept=".csv" class="tm-input" required>
          </div>

          <div class="tm-field">
            <label class="tm-field__label" for="tm-import-sprint">Add every task to a sprint</label>
            <select name="sprint_id" id="tm-import-sprint" class="tm-select">
              <option value="">None — leave them as internal work</option>
              <% @sprints.each do |sprint| %>
                <option value="<%= sprint.id %>"><%= sprint_label(sprint) %></option>
              <% end %>
            </select>
          </div>

          <label class="tm-check">
            <input type="checkbox" name="create_missing_types" value="1">
            <span>Create any task type the file mentions but your department doesn't have yet</span>
          </label>

          <div id="tm-import-preview" style="margin-top: 1.1rem"></div>
        </div>

        <div class="modal-footer">
          <button type="button" class="tm-btn" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="tm-btn" data-tm-preview="<%= import_preview_tasks_path %>">
            Check the file
          </button>
          <button type="submit" class="tm-btn tm-btn--primary">Import tasks</button>
        </div>
      </form>
    </div>
  </div>
</div>
