<%# One form for two jobs: editing a task, and adding a subtask under one.
    task_manager.js fills it from the JSON on the row that was clicked and
    points it at the right URL. %>
<div class="modal fade tm-modal" id="tm-task-edit-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <form id="tm-task-edit-form" data-tm-form data-tm-url="<%= tasks_path %>" data-tm-method="POST"
            data-tm-reset="false">
        <input type="hidden" name="_method" value="patch" id="tm-task-edit-method">
        <input type="hidden" name="task[parent_id]" id="tm-task-edit-parent">

        <div class="modal-header">
          <h2 class="modal-title" id="tm-task-edit-heading">Edit task</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="tm-alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><span class="tm-alert__text"></span></div>
          <p class="tm-muted" id="tm-task-edit-context" hidden></p>

          <div class="tm-field">
            <label class="tm-field__label" for="tm-edit-title">Title</label>
            <input type="text" name="task[title]" id="tm-edit-title" class="tm-input" required>
          </div>

          <div class="tm-field">
            <label class="tm-field__label" for="tm-edit-assignee">Executive</label>
            <select name="task[assigned_to_id]" id="tm-edit-assignee" class="tm-select" required>
              <% @executives.each do |executive| %>
                <option value="<%= executive.id %>"><%= executive.name %></option>
              <% end %>
            </select>
          </div>

          <div class="tm-field">
            <label class="tm-field__label" for="tm-edit-type">Task type</label>
            <select name="task[task_type_id]" id="tm-edit-type" class="tm-select" required>
              <% @task_types.each do |type| %>
                <option value="<%= type.id %>"><%= type.name %> — <%= type.formatted_sla %></option>
              <% end %>
            </select>
          </div>

          <div class="tm-field" id="tm-task-edit-sprint-wrap">
            <label class="tm-field__label" for="tm-edit-sprint">Client work this belongs to</label>
            <select name="task[sprint_id]" id="tm-edit-sprint" class="tm-select">
              <option value="">None — internal work</option>
              <%= grouped_options_for_select(sprint_options_grouped_by_project) %>
            </select>
            <p class="tm-field__hint">A subtask always follows its parent's sprint.</p>
          </div>

          <div class="tm-field__row">
            <div class="tm-field">
              <label class="tm-field__label" for="tm-edit-priority">Priority</label>
              <select name="task[priority]" id="tm-edit-priority" class="tm-select">
                <% Task::PRIORITIES.each do |priority| %>
                  <option value="<%= priority %>"><%= priority.capitalize %></option>
                <% end %>
              </select>
            </div>
            <div class="tm-field">
              <label class="tm-field__label" for="tm-edit-due">Due date</label>
              <input type="date" name="task[due_date]" id="tm-edit-due" class="tm-input">
            </div>
          </div>

          <div class="tm-field">
            <label class="tm-field__label" for="tm-edit-sla">Time budget in minutes</label>
            <input type="number" min="0" name="task[custom_sla_minutes]" id="tm-edit-sla" class="tm-input"
                   placeholder="Leave blank to use the type's budget">
          </div>

          <div class="tm-field">
            <label class="tm-field__label" for="tm-edit-description">Details</label>
            <textarea name="task[description]" id="tm-edit-description" class="tm-textarea" rows="3"></textarea>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="tm-btn" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="tm-btn tm-btn--primary" id="tm-task-edit-submit">Save changes</button>
        </div>
      </form>
    </div>
  </div>
</div>
