<% sub = local_assigns.fetch(:sub, false) %>
<% logged = task.subtask? ? task.live_duration_seconds : task.rolled_up_duration_seconds %>

<div class="tm-item <%= 'tm-item--sub' if sub %>" data-tm-open="<%= task.id %>">
  <div class="tm-item__main">
    <div class="tm-inline">
      <h3 class="tm-item__title">
        <button type="button" class="tm-title" data-tm-open="<%= task.id %>"><%= task.title %></button>
      </h3>
      <%= task_status_badge(task.status) %>
      <% if task.priority == "urgent" && !task.completed? %>
        <span class="tm-flag tm-flag--urgent">Urgent</span>
      <% end %>
      <span class="tm-flag tm-flag--sub" data-tm-comment-badge="<%= task.id %>"
            <%= "hidden" if task.comments_count.zero? %>>
        <i class="fa-regular fa-comment" aria-hidden="true"></i><span data-tm-comment-badge-value><%= task.comments_count %></span>
      </span>
    </div>

    <div class="tm-item__meta">
      <span><i class="fa-solid fa-tag" aria-hidden="true"></i> <%= task.task_type.name %></span>
      <% if task.sprint.present? %>
        <span><i class="fa-solid fa-flag" aria-hidden="true"></i> <%= task.sprint.project.client.name %></span>
      <% end %>
      <span class="<%= 'tm-flag tm-flag--sla' if task_overdue?(task) %>"><%= task_due_label(task) %></span>
      <span class="tm-who"><%= task_avatar(task.assigned_by) %>from <%= task.assigned_by.name %></span>
    </div>

    <% if task.description.present? %>
      <p class="tm-sub" style="margin: 0.35rem 0 0; max-width: 70ch"><%= truncate(task.description, length: 160) %></p>
    <% end %>

    <% if task.paused? && task.reason.present? %>
      <div class="tm-note">
        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
        <span><%= task.reason %></span>
      </div>
    <% end %>
  </div>

  <div class="tm-item__side">
    <div class="tm-item__time">
      <% if task.in_progress? %>
        <span class="tm-item__figure" data-tm-timer="<%= task.started_at.iso8601 %>"
              data-tm-paused="<%= task.accumulated_pause_seconds %>"
              data-tm-style="clock"><%= hours_label(logged, blank: "0m") %></span>
      <% else %>
        <span class="tm-item__figure <%= 'tm-muted' if logged.zero? %>"><%= hours_label(logged, blank: "0m") %></span>
      <% end %>
      <span class="tm-sub"><%= task.sla_seconds.positive? ? "of #{task.formatted_sla}" : "no budget" %></span>
    </div>

    <div class="tm-item__actions">
      <% if task.pending? %>
        <button type="button" class="tm-btn tm-btn--go tm-btn--sm"
                data-tm-action="<%= start_task_path(task) %>" data-tm-method="POST">
          <i class="fa-solid fa-play" aria-hidden="true"></i>Start
        </button>
      <% elsif task.in_progress? %>
        <button type="button" class="tm-btn tm-btn--hold tm-btn--sm"
                data-bs-toggle="modal" data-bs-target="#tm-pause-modal"
                data-tm-pause-url="<%= pause_task_path(task) %>"
                data-tm-pause-title="<%= task.title %>">
          <i class="fa-solid fa-pause" aria-hidden="true"></i>Pause
        </button>
        <button type="button" class="tm-btn tm-btn--done tm-btn--sm"
                data-tm-action="<%= complete_task_path(task) %>" data-tm-method="POST"
                data-tm-confirm="Mark “<%= task.title %>” as done?">
          <i class="fa-solid fa-check" aria-hidden="true"></i>Complete
        </button>
      <% elsif task.paused? %>
        <button type="button" class="tm-btn tm-btn--go tm-btn--sm"
                data-tm-action="<%= resume_task_path(task) %>" data-tm-method="POST">
          <i class="fa-solid fa-play" aria-hidden="true"></i>Resume
        </button>
        <button type="button" class="tm-btn tm-btn--done tm-btn--sm"
                data-tm-action="<%= complete_task_path(task) %>" data-tm-method="POST"
                data-tm-confirm="Mark “<%= task.title %>” as done?">
          <i class="fa-solid fa-check" aria-hidden="true"></i>Complete
        </button>
      <% else %>
        <button type="button" class="tm-btn tm-btn--sm" data-tm-open="<%= task.id %>">Open</button>
      <% end %>
    </div>
  </div>
</div>
