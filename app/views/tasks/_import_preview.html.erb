<% ok = importer.valid? %>
<div class="<%= ok ? 'tm-note' : 'tm-alert is-shown' %>" style="margin-bottom: 0.8rem">
  <i class="fa-solid fa-<%= ok ? 'circle-check' : 'circle-exclamation' %>" aria-hidden="true"></i>
  <span>
    <% if ok %>
      All <%= importer.rows.size %> row<%= "s" if importer.rows.size != 1 %> check out. Press Import tasks to commit.
    <% else %>
      <%= importer.error_count %> row<%= "s" if importer.error_count != 1 %> need fixing.
      Nothing is imported until every row is clean.
    <% end %>
  </span>
</div>

<div class="tm-tablewrap">
  <table class="tm-table">
    <thead>
      <tr>
        <th scope="col">Line</th>
        <th scope="col">Title</th>
        <th scope="col">Assignee</th>
        <th scope="col">Parent</th>
        <th scope="col">Result</th>
      </tr>
    </thead>
    <tbody>
      <% importer.rows.each do |row| %>
        <tr>
          <td><%= row.line %></td>
          <td><%= row.title %></td>
          <td><%= row.assignee_email %></td>
          <td><%= row.parent_key.presence || "—" %></td>
          <td>
            <% if row.errors.any? %>
              <span class="tm-flag tm-flag--sla"><%= row.errors.join("; ") %></span>
            <% else %>
              <span class="tm-badge tm-badge--completed">Ready</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
