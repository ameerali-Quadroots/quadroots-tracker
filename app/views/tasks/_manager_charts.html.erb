<%# Two charts and one meter, each answering a question the manager actually
    has. The old status-distribution chart is gone on purpose: the workload
    chart already carries the status split, per executive, which is the useful
    version of the same information.

    Every chart ships a legend, direct labels and a table twin — the module's
    green sits just under 3:1 on white, so the numbers are never reachable by
    colour alone. %>
<% workload = @report.workload_by_executive %>
<% throughput = @report.throughput %>

<div class="tm-grid">
  <section class="tm-panel">
    <div class="tm-panel__head">
      <div>
        <h2 class="tm-panel__title">Workload by executive</h2>
        <p class="tm-panel__sub">Every task in the department, by who holds it</p>
      </div>
      <div class="tm-panel__tools">
        <button type="button" class="tm-reveal" data-tm-reveal="#tm-workload-table"
                aria-expanded="false" aria-controls="tm-workload-table">
          <i class="fa-solid fa-table-list" aria-hidden="true"></i>
          <span class="tm-reveal__label">Show the numbers</span>
        </button>
      </div>
    </div>

    <div class="tm-panel__body">
      <% if workload.empty? %>
        <div class="tm-empty">
          <span class="tm-empty__icon"><i class="fa-solid fa-user-group" aria-hidden="true"></i></span>
          <p class="tm-empty__title">No tasks assigned yet</p>
          <p class="tm-empty__body">Assign the first task and this chart shows how the work is spread.</p>
        </div>
      <% else %>
        <ul class="tm-legend">
          <% TasksHelper::STATUS_ROLES.each do |status, role| %>
            <li><span class="tm-key tm-key--<%= status %>"></span><%= role[:label] %></li>
          <% end %>
        </ul>

        <% plot_height = [workload.size * 46 + 52, 176].max %>
        <div class="tm-chart tm-chart--tall" style="height: <%= plot_height %>px">
          <canvas data-tm-chart="<%= chart_spec(workload_chart_spec(workload)) %>"
                  role="img"
                  aria-label="Tasks per executive, split by status. The same figures are in the table below."></canvas>
        </div>

        <div class="tm-datatable tm-tablewrap" id="tm-workload-table" hidden>
          <table class="tm-table">
            <caption class="tm-sub">Tasks per executive, by status</caption>
            <thead>
              <tr>
                <th scope="col">Executive</th>
                <% TasksHelper::STATUS_ROLES.each_value do |role| %>
                  <th scope="col" class="tm-num"><%= role[:label] %></th>
                <% end %>
                <th scope="col" class="tm-num">Total</th>
              </tr>
            </thead>
            <tbody>
              <% workload.each do |name, counts| %>
                <tr>
                  <th scope="row"><%= name %></th>
                  <% TasksHelper::STATUS_ROLES.each_key do |status| %>
                    <td class="tm-num"><%= counts[status].to_i %></td>
                  <% end %>
                  <td class="tm-num tm-strong"><%= counts.values.sum %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </section>

  <div class="tm-grid__stack">
    <section class="tm-panel">
      <div class="tm-panel__head">
        <div>
          <h2 class="tm-panel__title">Tasks completed per day</h2>
          <p class="tm-panel__sub">Last <%= Reports::TaskDashboard::THROUGHPUT_DAYS %> days</p>
        </div>
      </div>
      <div class="tm-panel__body">
        <% if throughput.sum(&:last).zero? %>
          <p class="tm-muted">Nothing has been completed in the last fortnight.</p>
        <% else %>
          <div class="tm-chart tm-chart--short">
            <canvas data-tm-chart="<%= chart_spec(throughput_chart_spec(throughput)) %>"
                    role="img"
                    aria-label="<%= throughput.map { |d, n| "#{d.strftime('%-d %b')}: #{n}" }.join(', ') %>"></canvas>
          </div>
        <% end %>
      </div>
    </section>

    <section class="tm-panel">
      <div class="tm-panel__head">
        <div>
          <h2 class="tm-panel__title">Time budgets</h2>
          <p class="tm-panel__sub">How finished work landed against its SLA</p>
        </div>
      </div>
      <div class="tm-panel__body">
        <% if @report.completed_count.zero? %>
          <p class="tm-muted">No completed tasks yet, so there is nothing to measure.</p>
        <% else %>
          <% rate = @report.on_time_rate %>
          <div class="tm-meter-row">
            <span class="tm-meter-row__value" data-numeric><%= rate %>% inside budget</span>
            <span class="tm-meter-row__limit">
              <%= @report.completed_count - @report.completed_over_sla %> of <%= @report.completed_count %>
            </span>
          </div>
          <span class="tm-meter" role="img"
                aria-label="<%= rate %>% of completed tasks finished inside their time budget">
            <span class="tm-meter__fill <%= rate >= 90 ? 'tm-meter__fill--done' : (rate >= 70 ? 'tm-meter__fill--warn' : 'tm-meter__fill--over') %>"
                  style="width: <%= rate %>%"></span>
          </span>

          <ul class="tm-rows" style="margin-top: 1rem">
            <li>
              <span class="tm-rows__grow">Finished over budget</span>
              <span class="tm-rows__num"><%= @report.completed_over_sla %></span>
            </li>
            <li>
              <span class="tm-rows__grow">Running over budget now</span>
              <span class="tm-rows__num"><%= @report.over_sla_count - @report.completed_over_sla %></span>
            </li>
          </ul>
        <% end %>
      </div>
    </section>
  </div>
</div>
