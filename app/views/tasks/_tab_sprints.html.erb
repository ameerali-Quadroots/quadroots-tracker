<div class="task-panel-dark">
  <div class="task-panel-dark__header">
    <div>
      <h3 class="task-panel-dark__title">Sprints</h3>
      <p class="text-muted small mb-0">Client work, broken into weekly cycles</p>
    </div>
    <div class="task-panel-dark__controls">
      <button type="button" class="btn btn-outline-premium btn-premium btn-sm"
              data-bs-toggle="modal" data-bs-target="#newClientModal">
        <i class="fa-solid fa-building me-2"></i>New client
      </button>
      <button type="button" class="btn btn-outline-premium btn-premium btn-sm"
              data-bs-toggle="modal" data-bs-target="#newProjectModal">
        <i class="fa-solid fa-diagram-project me-2"></i>New project
      </button>
      <button type="button" class="btn btn-primary btn-premium btn-sm"
              data-bs-toggle="modal" data-bs-target="#newSprintModal">
        <i class="fa-solid fa-plus me-2"></i>New sprint
      </button>
    </div>
  </div>

  <div class="task-panel-dark__body">
    <% if @sprints.empty? %>
      <div class="task-empty-state">
        <i class="fa-solid fa-flag-checkered"></i>
        <p class="mb-1 fw-semibold">No sprints yet</p>
        <p>Add a client, give it a project, then open its first weekly sprint.</p>
        <button type="button" class="btn btn-primary btn-premium btn-sm"
                data-bs-toggle="modal" data-bs-target="#newClientModal">
          <i class="fa-solid fa-building me-2"></i>Add your first client
        </button>
      </div>
    <% else %>
      <% @sprints.group_by { |s| s.project.client }.each do |client, client_sprints| %>
        <% client_sprints.group_by(&:project).each do |project, project_sprints| %>
          <div class="sprint-group">
            <h6 class="sprint-group__client"><%= client.name %></h6>
            <p class="sprint-group__project"><%= project.name %></p>

            <% project_sprints.each do |sprint| %>
              <% done, total = sprint.progress %>
              <% pct = total.zero? ? 0 : (done * 100.0 / total).round %>
              <div class="sprint-row">
                <div class="sprint-row__main">
                  <div class="sprint-row__name"><%= sprint.name %></div>
                  <% if sprint.goal.present? %>
                    <div class="sprint-row__goal"><%= sprint.goal %></div>
                  <% end %>
                </div>

                <div class="sprint-row__meta">
                  <span><%= sprint.start_date.strftime("%d %b") %> – <%= sprint.end_date.strftime("%d %b") %></span>
                  <span class="pill pill--<%= sprint.status %>"><%= sprint.status.humanize %></span>
                  <span><%= hours_label(sprint.logged_seconds) %> logged</span>
                </div>

                <div class="sprint-progress">
                  <div class="sprint-progress__track"
                       role="progressbar" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100"
                       aria-label="<%= sprint.name %> progress">
                    <div class="sprint-progress__fill" style="width: <%= pct %>%"></div>
                  </div>
                  <div class="sprint-progress__label"><%= done %> of <%= total %> done</div>
                </div>

                <%= link_to "View tasks", dashboard_tasks_path(sprint_id: sprint.id),
                      class: "btn btn-outline-premium btn-premium btn-sm" %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
