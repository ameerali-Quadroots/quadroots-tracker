<% logged = task.rolled_up_duration_seconds %>
<% sla = task.sla_seconds %>
<% pct = sla.positive? ? [(logged * 100.0 / sla).round, 100].min : 0 %>
<% done, total = task.subtask_progress %>

<div class="task-detail">
  <div class="modal-header task-detail__head">
    <div>
      <% if task.sprint.present? %>
        <nav class="task-detail__crumb" aria-label="Sprint">
          <%= task.sprint.project.client.name %>
          <span aria-hidden="true">/</span> <%= task.sprint.project.name %>
          <span aria-hidden="true">/</span> <%= task.sprint.name %>
        </nav>
      <% else %>
        <nav class="task-detail__crumb">Standalone task</nav>
      <% end %>
      <h5 class="task-detail__title"><%= task.title %></h5>
      <div class="task-detail__tags">
        <span class="pill pill--<%= task.status %>"><%= task.status.humanize %></span>
        <% if task.priority == "urgent" %><span class="pill pill--over-sla">Urgent</span><% end %>
        <% if task.over_sla? %><span class="pill pill--over-sla">Over SLA</span><% end %>
      </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>

  <div class="modal-body">
    <% if task.description.present? %>
      <p class="task-detail__desc"><%= simple_format(task.description) %></p>
    <% end %>

    <dl class="task-detail__meta">
      <div><dt>Assignee</dt><dd><%= task.assigned_to&.name || "—" %></dd></div>
      <div><dt>Type</dt><dd><%= task.task_type&.name || "—" %></dd></div>
      <div><dt>Due</dt><dd><%= task.due_date&.strftime("%d %b %Y") || "—" %></dd></div>
      <div><dt>Assigned by</dt><dd><%= task.assigned_by&.name || "—" %></dd></div>
      <% if task.parent.present? %>
        <div><dt>Subtask of</dt><dd><%= task.parent.title %></dd></div>
      <% end %>
    </dl>

    <section class="task-detail__section">
      <h6 class="task-detail__label">Time</h6>
      <div class="task-time">
        <div class="task-time__figure"><%= hours_label(logged) %></div>
        <div class="task-time__of">of <%= task.formatted_sla %> allowed</div>
      </div>
      <% if sla.positive? %>
        <div class="task-time__track" role="progressbar" aria-valuenow="<%= pct %>"
             aria-valuemin="0" aria-valuemax="100" aria-label="Time used against SLA">
          <div class="task-time__fill <%= 'task-time__fill--over' if task.over_sla? %>"
               style="width: <%= pct %>%"></div>
        </div>
      <% else %>
        <p class="text-muted small mb-0">No SLA set for this task type.</p>
      <% end %>
    </section>

    <% if total.positive? %>
      <section class="task-detail__section">
        <h6 class="task-detail__label">Subtasks <span class="text-muted fw-normal"><%= done %> of <%= total %> done</span></h6>
        <ul class="subtask-list">
          <% task.subtasks.each do |sub| %>
            <li class="subtask-list__item">
              <span class="pill pill--<%= sub.status %>"><%= sub.status.humanize %></span>
              <span class="subtask-list__title"><%= sub.title %></span>
              <span class="subtask-list__who"><%= sub.assigned_to&.name %></span>
              <span class="subtask-list__time"><%= hours_label(sub.live_duration_seconds) %></span>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% sessions = task.work_sessions.to_a + task.subtasks.flat_map { |s| s.work_sessions.to_a } %>
    <% by_day = sessions.group_by { |s| s.started_at.in_time_zone.to_date }.sort.reverse %>
    <section class="task-detail__section">
      <h6 class="task-detail__label">Activity</h6>
      <% if by_day.empty? %>
        <p class="text-muted small mb-0">No time logged yet. It appears here once the executive starts the timer.</p>
      <% else %>
        <ul class="activity-list">
          <% by_day.each do |day, rows| %>
            <li class="activity-list__row">
              <span class="activity-list__day"><%= day.strftime("%a %d %b") %></span>
              <span class="activity-list__who"><%= rows.map { |r| r.user&.name }.compact.uniq.join(", ") %></span>
              <span class="activity-list__hours"><%= hours_label(rows.sum(&:duration_seconds)) %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>

  <% if can_view?("task_manager") %>
    <div class="modal-footer task-detail__foot">
      <%= button_to "Delete task", task_path(task), method: :delete,
            class: "btn btn-outline-danger btn-premium btn-sm me-auto",
            form: { data: { turbo: false } },
            data: { confirm: "Delete \"#{task.title}\"#{total.positive? ? " and its #{total} subtask(s)" : ''}? This cannot be undone." } %>
      <button type="button" class="btn btn-outline-premium btn-premium btn-sm" data-bs-dismiss="modal">Close</button>
      <button type="button" class="btn btn-primary btn-premium btn-sm"
              data-task-edit="<%= task.id %>">Edit task</button>
    </div>
  <% end %>
</div>
