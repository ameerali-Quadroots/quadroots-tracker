<%# One filter row above the table it scopes. Every control here is AJAX: the
    server re-renders this region and the querystring is pushed, so the filtered
    view stays shareable and the back button still works. %>
<% filtered = params[:status].present? || params[:executive_id].present? ||
              params[:sprint_id].present? || params[:mine] == "1" ||
              params[:q].present? || params[:over] == "1" ||
              params[:client_id].present? || params[:priority].present? || params[:task_type_id].present? %>
<% first_row = @tasks_total.zero? ? 0 : (@page - 1) * @per_page + 1 %>
<% last_row  = [@page * @per_page, @tasks_total].min %>

<section class="tm-panel">
  <div class="tm-panel__head">
    <div class="tm-seg" role="group" aria-label="Filter by status">
      <button type="button" class="tm-seg__item <%= 'is-active' if params[:status].blank? && params[:over] != '1' %>"
              data-tm-filter='{"status":"","over":"","mine":""}' data-tm-regions="tasks">All</button>
      <% TasksHelper::STATUS_ROLES.each do |status, role| %>
        <button type="button" class="tm-seg__item <%= 'is-active' if params[:status] == status %>"
                data-tm-filter='<%= { status: status, over: "" }.to_json %>' data-tm-regions="tasks">
          <span class="tm-key tm-key--<%= status %>"></span><%= role[:label] %>
        </button>
      <% end %>
      <button type="button" class="tm-seg__item <%= 'is-active' if params[:over] == '1' %>"
              data-tm-filter='{"over":"1","status":""}' data-tm-regions="tasks">Over budget</button>
    </div>

    <div class="tm-panel__tools">
      <label class="tm-search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <span class="visually-hidden">Search tasks</span>
        <input type="search" class="tm-input" data-tm-search value="<%= params[:q] %>"
               placeholder="Search tasks" autocomplete="off">
      </label>

      <label>
        <span class="visually-hidden">Filter by executive</span>
        <select class="tm-select tm-select--inline" data-tm-filter-field="executive_id" data-tm-regions="tasks">
          <option value="">All executives</option>
          <% @executives.each do |executive| %>
            <option value="<%= executive.id %>" <%= "selected" if params[:executive_id].to_s == executive.id.to_s %>>
              <%= executive.name %>
            </option>
          <% end %>
        </select>
      </label>

      <% if @clients.any? %>
        <label>
          <span class="visually-hidden">Filter by client</span>
          <select class="tm-select tm-select--inline" data-tm-filter-field="client_id" data-tm-regions="tasks">
            <option value="">All clients</option>
            <% @clients.each do |client| %>
              <option value="<%= client.id %>" <%= "selected" if params[:client_id].to_s == client.id.to_s %>><%= client.name %></option>
            <% end %>
          </select>
        </label>
      <% end %>

      <% if @sprints.any? %>
        <label>
          <span class="visually-hidden">Filter by sprint</span>
          <select class="tm-select tm-select--inline" data-tm-filter-field="sprint_id" data-tm-regions="tasks">
            <option value="">All sprints</option>
            <% @sprints.each do |sprint| %>
              <option value="<%= sprint.id %>" <%= "selected" if params[:sprint_id].to_s == sprint.id.to_s %>>
                <%= sprint_label(sprint) %>
              </option>
            <% end %>
          </select>
        </label>
      <% end %>

      <% if @task_types.any? %>
        <label>
          <span class="visually-hidden">Filter by task type</span>
          <select class="tm-select tm-select--inline" data-tm-filter-field="task_type_id" data-tm-regions="tasks">
            <option value="">All types</option>
            <% @task_types.each do |type| %>
              <option value="<%= type.id %>" <%= "selected" if params[:task_type_id].to_s == type.id.to_s %>><%= type.name %></option>
            <% end %>
          </select>
        </label>
      <% end %>

      <label>
        <span class="visually-hidden">Filter by priority</span>
        <select class="tm-select tm-select--inline" data-tm-filter-field="priority" data-tm-regions="tasks">
          <option value="">Any priority</option>
          <% Task::PRIORITIES.each do |priority| %>
            <option value="<%= priority %>" <%= "selected" if params[:priority] == priority %>><%= priority.capitalize %></option>
          <% end %>
        </select>
      </label>

      <button type="button" class="tm-btn tm-btn--sm <%= 'tm-btn--primary' if params[:mine] == '1' %>"
              data-tm-filter='<%= { mine: params[:mine] == "1" ? "" : "1" }.to_json %>' data-tm-regions="tasks">
        Assigned by me
      </button>
    </div>
  </div>

  <% if @tasks_total.zero? %>
    <div class="tm-empty">
      <span class="tm-empty__icon"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i></span>
      <% if filtered %>
        <p class="tm-empty__title">Nothing matches these filters</p>
        <p class="tm-empty__body">Widen the search, or clear the filters to see the whole department's work.</p>
        <button type="button" class="tm-btn tm-btn--sm"
                data-tm-filter='{"status":"","executive_id":"","sprint_id":"","mine":"","q":"","over":"","client_id":"","priority":"","task_type_id":""}'
                data-tm-regions="tasks">Clear filters</button>
      <% else %>
        <p class="tm-empty__title">No tasks yet</p>
        <p class="tm-empty__body">Assign the first task to an executive, or import a batch from a CSV.</p>
        <button type="button" class="tm-btn tm-btn--primary tm-btn--sm"
                data-bs-toggle="modal" data-bs-target="#tm-new-task-modal">
          <i class="fa-solid fa-plus" aria-hidden="true"></i>New task
        </button>
      <% end %>
    </div>
  <% else %>
    <% if filtered %>
      <div class="tm-filterbar">
        <span><%= pluralize(@tasks_total, "task") %> match your filters</span>
        <button type="button" class="tm-btn tm-btn--sm tm-btn--ghost"
                data-tm-filter='{"status":"","executive_id":"","sprint_id":"","mine":"","q":"","over":"","client_id":"","priority":"","task_type_id":""}'
                data-tm-regions="tasks"><i class="fa-solid fa-xmark" aria-hidden="true"></i>Clear filters</button>
      </div>
    <% end %>

    <%# The list scrolls inside its own frame with the header pinned, so the
        page does not grow by a screen for every twenty tasks. %>
    <div class="tm-tablewrap tm-scroll tm-scroll--tall">
      <table class="tm-table tm-table--sticky">
        <thead>
          <tr>
            <th scope="col">Task</th>
            <th scope="col">Client</th>
            <th scope="col">Executive</th>
            <th scope="col">Status</th>
            <th scope="col">Due</th>
            <th scope="col" class="tm-num">Logged</th>
            <th scope="col">Budget</th>
            <th scope="col" class="tm-shrink"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @tasks.each do |task| %>
            <%= render "tasks/task_row", task: task %>
            <% task.subtasks.each do |subtask| %>
              <%= render "tasks/task_row", task: subtask %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <nav class="tm-pager" aria-label="Task list pages">
      <span class="tm-pager__info">Showing <b><%= first_row %></b> to <b><%= last_row %></b> of <b><%= @tasks_total %></b></span>

      <label class="tm-pager__size">
        <span>Rows per page</span>
        <select class="tm-select tm-select--inline" data-tm-filter-field="per" data-tm-regions="tasks" aria-label="Rows per page">
          <% TasksController::PER_PAGE_OPTIONS.each do |size| %>
            <option value="<%= size %>" <%= "selected" if @per_page == size %>><%= size %></option>
          <% end %>
        </select>
      </label>

      <% if @total_pages > 1 %>
        <%# First, last and the pages around the current one; gaps become an ellipsis. %>
        <% pages = ([1, @total_pages] + ((@page - 1)..(@page + 1)).to_a).select { |n| n.between?(1, @total_pages) }.uniq.sort %>
        <div class="tm-pager__pages">
          <button type="button" class="tm-btn tm-btn--sm tm-btn--icon" aria-label="Previous page" <%= "disabled" if @page == 1 %>
                  data-tm-filter='<%= { page: @page - 1 }.to_json %>' data-tm-regions="tasks">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
          </button>
          <% pages.each_with_index do |number, index| %>
            <% if index.positive? && number - pages[index - 1] > 1 %><span class="tm-pager__gap">…</span><% end %>
            <button type="button" class="tm-btn tm-btn--sm <%= 'tm-btn--primary' if number == @page %>"
                    <%= 'aria-current="page"'.html_safe if number == @page %>
                    data-tm-filter='<%= { page: number }.to_json %>' data-tm-regions="tasks"><%= number %></button>
          <% end %>
          <button type="button" class="tm-btn tm-btn--sm tm-btn--icon" aria-label="Next page" <%= "disabled" if @page == @total_pages %>
                  data-tm-filter='<%= { page: @page + 1 }.to_json %>' data-tm-regions="tasks">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
          </button>
        </div>
      <% end %>
    </nav>
  <% end %>
</section>
