<div class="dashboard-container">
  <div class="dashboard-glass">

<div class="dashboard-card task-page-card p-4 mb-4">
  <h3 class="fw-bold mb-1">My Tasks</h3>
  <p class="text-muted mb-0">Tasks assigned to you. Only one can be in progress at a time.</p>
</div>

<div class="task-stat-cards mb-4">
  <div class="task-stat-card">
    <div class="task-stat-icon task-stat-icon--warning"><i class="fa-solid fa-hourglass-half"></i></div>
    <div>
      <span class="task-stat-label">Pending</span>
      <span class="task-stat-value"><%= @tasks.count(&:pending?) %></span>
    </div>
  </div>
  <div class="task-stat-card">
    <div class="task-stat-icon task-stat-icon--info"><i class="fa-solid fa-play"></i></div>
    <div>
      <span class="task-stat-label">In Progress</span>
      <span class="task-stat-value"><%= @tasks.count(&:in_progress?) %></span>
    </div>
  </div>
  <div class="task-stat-card">
    <div class="task-stat-icon task-stat-icon--orange"><i class="fa-solid fa-pause"></i></div>
    <div>
      <span class="task-stat-label">Paused</span>
      <span class="task-stat-value"><%= @tasks.count(&:paused?) %></span>
    </div>
  </div>
  <div class="task-stat-card">
    <div class="task-stat-icon task-stat-icon--success"><i class="fa-solid fa-circle-check"></i></div>
    <div>
      <span class="task-stat-label">Completed</span>
      <span class="task-stat-value"><%= @tasks.count(&:completed?) %></span>
    </div>
  </div>
</div>

<div class="task-panel-dark">
  <div class="task-panel-dark__header">
    <h3 class="task-panel-dark__title">Your Tasks</h3>
  </div>

  <div class="task-panel-dark__body">
    <% if @tasks.empty? %>
      <div class="task-empty-state">
        <i class="fa-solid fa-clipboard-list"></i>
        <p>No tasks have been assigned to you yet.</p>
      </div>
    <% else %>
      <% @tasks.each do |task| %>
        <div class="task-row d-flex flex-wrap justify-content-between align-items-start gap-3">
          <div>
            <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
              <h5 class="fw-bold mb-0"><%= task.title %></h5>
              <span class="pill pill--<%= task.status %>"><%= task.status.humanize %></span>
              <% if task.over_sla? %>
                <span class="pill pill--over-sla">Over SLA</span>
              <% end %>
              <span class="type-tag"><%= task.priority.capitalize %></span>
            </div>
            <div class="text-muted small mb-1">
              <i class="fa-solid fa-tag me-1"></i><%= task.task_type.name %>
              <span class="sla-chip ms-1"><i class="fa-solid fa-stopwatch me-1"></i>SLA <%= task.task_type.formatted_sla %></span>
            </div>
            <% if task.description.present? %>
              <p class="text-muted mb-2"><%= task.description %></p>
            <% end %>
            <div class="text-muted small d-flex align-items-center">
              <span class="task-avatar"><%= task.assigned_by.initials %></span>
              Assigned by <span class="fw-semibold text-dark ms-1"><%= task.assigned_by.name %></span>
              <% if task.due_date.present? %>&nbsp;&middot; Due <%= task.due_date.strftime("%d %b %Y") %><% end %>
            </div>
            <% if task.paused? && task.reason.present? %>
              <div class="task-reason-note"><i class="fa-solid fa-circle-info"></i><%= task.reason %></div>
            <% end %>
          </div>

          <div class="text-end">
            <div class="task-duration mb-2"><%= render "tasks/live_task_duration", task: task %></div>

            <% if task.pending? %>
              <%= button_to start_task_path(task), method: :post, class: "btn btn-primary btn-premium btn-sm", data: { turbo: false } do %>
                <i class="fa-solid fa-play me-1"></i>Start
              <% end %>
            <% elsif task.in_progress? %>
              <button type="button" class="btn btn-warning btn-premium btn-sm" data-bs-toggle="modal" data-bs-target="#pauseModal-<%= task.id %>">
                <i class="fa-solid fa-pause me-1"></i>Pause
              </button>
              <%= button_to complete_task_path(task), method: :post, class: "btn btn-success btn-premium btn-sm", data: { turbo: false } do %>
                <i class="fa-solid fa-circle-check me-1"></i>Complete
              <% end %>
            <% elsif task.paused? %>
              <%= button_to resume_task_path(task), method: :post, class: "btn btn-primary btn-premium btn-sm", data: { turbo: false } do %>
                <i class="fa-solid fa-play me-1"></i>Resume
              <% end %>
              <%= button_to complete_task_path(task), method: :post, class: "btn btn-success btn-premium btn-sm", data: { turbo: false } do %>
                <i class="fa-solid fa-circle-check me-1"></i>Complete
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

  </div>
</div>

<%# Modals render outside .dashboard-glass — its backdrop-filter creates a
    containing block for position:fixed children, which would trap a modal
    inside the card instead of covering the viewport (same reason
    shared/_edit_request_modal is rendered after the glass wrapper closes). %>
<% @tasks.select(&:in_progress?).each do |task| %>
  <div class="modal fade" id="pauseModal-<%= task.id %>" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content dashboard-card">
        <%= form_with(url: pause_task_path(task), method: :post, local: true, html: { data: { turbo: false } }) do %>
          <div class="modal-header">
            <h5 class="modal-title fw-bold"><i class="fa-solid fa-pause me-2 text-warning"></i>Pause Task</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <label class="form-label fw-semibold text-dark">Reason (optional)</label>
            <textarea name="reason" class="form-control" rows="3" placeholder="Why are you pausing this task?"></textarea>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-premium btn-premium" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-warning btn-premium">Pause Task</button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<script>
  document.querySelectorAll('[data-task-start]').forEach(function (el) {
    var span = document.getElementById('task-duration-' + el.dataset.taskId);
    if (!span) return;
    var start = new Date(el.dataset.taskStart);
    var pauseSeconds = parseInt(el.dataset.taskPauseSeconds, 10) || 0;

    function tick() {
      var elapsed = Math.max((new Date() - start) / 1000 - pauseSeconds, 0);
      var h = Math.floor(elapsed / 3600);
      var m = Math.floor((elapsed % 3600) / 60);
      var s = Math.floor(elapsed % 60);
      span.textContent = h + "h " + String(m).padStart(2, "0") + "m " + String(s).padStart(2, "0") + "s";
    }
    tick();
    setInterval(tick, 1000);
  });
</script>
