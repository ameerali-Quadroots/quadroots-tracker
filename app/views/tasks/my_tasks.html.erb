<%= render "tasks/head" %>

<div class="tm" data-tm-view="my_tasks">
  <div class="tm__inner">

    <header class="tm-head">
      <div>
        <h1 class="tm-head__title">My tasks</h1>
        <p class="tm-head__sub">
          <%= @report.open_count %> open · one task runs at a time, so pause before you switch
        </p>
      </div>
    </header>

    <div id="tm-region-focus"><%= render "tasks/executive_focus" %></div>
    <div id="tm-region-summary"><%= render "tasks/executive_summary" %></div>
    <div id="tm-region-tasks"><%= render "tasks/panel_my_tasks" %></div>

  </div>
</div>

<%= render "tasks/drawer_shell" %>
<%= render "tasks/pause_modal" %>
