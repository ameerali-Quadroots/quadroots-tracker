<%# Loaded only by the Task Manager pages. Inter is the module's one typeface:
    a grotesque drawn for interface text at small sizes, with true tabular
    figures — what a screen of durations and time budgets needs. %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
  <%= javascript_include_tag "task_manager", defer: true %>
<% end %>
