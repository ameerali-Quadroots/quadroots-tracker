<%# Loaded only by the Task Manager pages. IBM Plex Sans is the module's one
    typeface — an engineered grotesque with real tabular figures, which is what
    a screen full of durations and time budgets needs. %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap">
  <%= javascript_include_tag "task_manager", defer: true %>
<% end %>
