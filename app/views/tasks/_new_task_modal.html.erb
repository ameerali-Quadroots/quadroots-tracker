<div class="modal fade tm-modal" id="tm-new-task-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <form data-tm-form data-tm-url="<%= tasks_path %>" data-tm-method="POST">
        <div class="modal-header">
          <h2 class="modal-title">New task</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="tm-alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><span class="tm-alert__text"></span></div>

          <div class="tm-field">
            <label class="tm-field__label" for="tm-new-title">What needs doing?</label>
            <input type="text" name="task[title]" id="tm-new-title" class="tm-input" required
                   placeholder="Update the client's homepage copy">
          </div>

          <div class="tm-field">
            <label class="tm-field__label" for="tm-new-assignee">Who is doing it?</label>
            <select name="task[assigned_to_id]" id="tm-new-assignee" class="tm-select" required>
              <option value="">Choose an executive</option>
              <% @executives.each do |executive| %>
                <option value="<%= executive.id %>"><%= executive.name %></option>
              <% end %>
            </select>
            <% if @executives.empty? %>
              <p class="tm-field__hint">
                No executives in your department yet. Add them under Settings before assigning work.
              </p>
            <% end %>
          </div>

          <div class="tm-field">
            <label class="tm-field__label" for="tm-new-type-select">Task type</label>
            <select name="task[task_type_id]" id="tm-new-type-select" class="tm-select" data-tm-type-select required>
              <option value="">Choose a type</option>
              <% @task_types.each do |type| %>
                <option value="<%= type.id %>" data-sla="<%= type.sla_minutes %>"
                        data-description="<%= type.description %>"><%= type.name %></option>
              <% end %>
              <option value="__new__">Add a new type…</option>
            </select>
            <p class="tm-field__hint" id="tm-type-description"></p>
          </div>

          <div class="tm-field" id="tm-new-type" hidden>
            <label class="tm-field__label" for="tm-new-type-name">Name the new type</label>
            <input type="text" name="task[new_task_type_name]" id="tm-new-type-name" class="tm-input"
                   placeholder="Client onboarding">
            <p class="tm-field__hint">Saved for your department, so it is in the list next time.</p>
          </div>

          <div class="tm-field">
            <label class="tm-field__label" for="tm-sla">Time budget in minutes</label>
            <input type="number" min="0" name="task[custom_sla_minutes]" id="tm-sla" class="tm-input"
                   placeholder="Leave blank to use the type's budget">
            <p class="tm-field__hint" id="tm-sla-hint"></p>
          </div>

          <div class="tm-field">
            <label class="tm-field__label" for="tm-new-sprint">Client work this belongs to</label>
            <select name="task[sprint_id]" id="tm-new-sprint" class="tm-select">
              <option value="">None — internal work</option>
              <%= grouped_options_for_select(sprint_options_grouped_by_project, params[:sprint_id]) %>
            </select>
          </div>

          <div class="tm-field__row">
            <div class="tm-field">
              <label class="tm-field__label" for="tm-new-priority">Priority</label>
              <select name="task[priority]" id="tm-new-priority" class="tm-select">
                <% Task::PRIORITIES.each do |priority| %>
                  <option value="<%= priority %>"><%= priority.capitalize %></option>
                <% end %>
              </select>
            </div>
            <div class="tm-field">
              <label class="tm-field__label" for="tm-new-due">Due date</label>
              <input type="date" name="task[due_date]" id="tm-new-due" class="tm-input">
            </div>
          </div>

          <div class="tm-field">
            <label class="tm-field__label" for="tm-new-description">Details</label>
            <textarea name="task[description]" id="tm-new-description" class="tm-textarea" rows="3"
                      placeholder="Anything the executive needs to know before starting."></textarea>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="tm-btn" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="tm-btn tm-btn--primary">Assign task</button>
        </div>
      </form>
    </div>
  </div>
</div>
