<%= render "tasks/head" %>

<div class="tm" data-tm-view="dashboard">
  <div class="tm__inner">

    <header class="tm-head">
      <div>
        <h1 class="tm-head__title">Task Manager</h1>
        <p class="tm-head__sub">
          <%= @executives.size %> executive<%= "s" if @executives.size != 1 %> in
          <%= current_user.org_department&.name || "your department" %>
        </p>
      </div>
      <div class="tm-head__actions">
        <button type="button" class="tm-btn" data-bs-toggle="modal" data-bs-target="#tm-import-modal">
          <i class="fa-solid fa-file-csv" aria-hidden="true"></i>Import CSV
        </button>
        <button type="button" class="tm-btn tm-btn--primary" data-bs-toggle="modal" data-bs-target="#tm-new-task-modal">
          <i class="fa-solid fa-plus" aria-hidden="true"></i>New task
        </button>
      </div>
    </header>

    <div id="tm-region-summary"><%= render "tasks/manager_summary" %></div>
    <div id="tm-region-charts"><%= render "tasks/manager_charts" %></div>

    <% active_tab = params[:tab].presence_in(%w[tasks team_hours sprints]) || "tasks" %>

    <div class="tm-tabbar">
      <div class="tm-seg" role="tablist" aria-label="Task Manager sections">
        <button type="button" class="tm-seg__item" role="tab" data-tm-tab="tasks"
                aria-selected="<%= active_tab == 'tasks' %>">
          Tasks <span class="tm-seg__count"><%= @tasks.size %></span>
        </button>
        <button type="button" class="tm-seg__item" role="tab" data-tm-tab="team_hours"
                aria-selected="<%= active_tab == 'team_hours' %>">
          Team hours <span class="tm-seg__count"><%= @hours_report.executives.size %></span>
        </button>
        <button type="button" class="tm-seg__item" role="tab" data-tm-tab="sprints"
                aria-selected="<%= active_tab == 'sprints' %>">
          Sprints <span class="tm-seg__count"><%= @sprints.size %></span>
        </button>
      </div>
    </div>

    <div data-tm-panel="tasks" <%= "hidden" unless active_tab == "tasks" %>>
      <div id="tm-region-tasks"><%= render "tasks/panel_tasks" %></div>
    </div>
    <div data-tm-panel="team_hours" <%= "hidden" unless active_tab == "team_hours" %>>
      <div id="tm-region-team-hours"><%= render "tasks/panel_team_hours" %></div>
    </div>
    <div data-tm-panel="sprints" <%= "hidden" unless active_tab == "sprints" %>>
      <div id="tm-region-sprints"><%= render "tasks/panel_sprints" %></div>
    </div>

  </div>
</div>

<%= render "tasks/drawer_shell" %>
<%= render "tasks/new_task_modal" %>
<%= render "tasks/task_edit_modal" %>
<%= render "tasks/import_modal" %>
<%= render "tasks/sprint_modal" %>
