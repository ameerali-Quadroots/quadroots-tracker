<%# Team attendance over the last 12 months, one card per department the
    manager's reports sit in. Data: DashboardController#load_monthly_dept_stats.
    Styles: the .team-* rules in _app_insights.scss. %>
<% if @monthly_dept_stats.present? && @monthly_dept_stats.values.any?(&:any?) %>
<section class="team-report" aria-labelledby="team-report-title">
  <header class="insights-head">
    <div>
      <h2 class="insights-title" id="team-report-title">Team attendance</h2>
      <p class="insights-month">Clock-ins, lates and half days over the last 12 months</p>
    </div>
    <span class="team-count"><%= pluralize(@target_departments.length, "department") %></span>
  </header>

  <div class="team-grid <%= 'team-grid--two' if @target_departments.length > 1 %>">
    <% @target_departments.each do |dept| %>
      <% stats = @monthly_dept_stats[dept] %>
      <% next if stats.blank? %>
      <% summary = @dept_summary&.dig(dept) || {} %>
      <%
        max_lates = [stats.map { |s| s[:lates] }.max.to_i, 1].max
        max_hd    = [stats.map { |s| s[:half_days] }.max.to_i, 1].max
        max_ci    = [stats.map { |s| s[:clock_ins] }.max.to_i, 1].max
        total_ci  = summary[:total_clock_ins] || stats.sum { |s| s[:clock_ins] }
        total_lt  = summary[:total_lates]     || stats.sum { |s| s[:lates] }
        total_hd  = stats.sum { |s| s[:half_days] }
        total_ot  = summary[:total_on_time]   || (total_ci - total_lt)
        most_late_user  = summary[:most_late_user]
        most_late_count = summary[:most_late_count].to_i
        ontime_pct = total_ci > 0 ? (total_ot.to_f / total_ci * 100).round : 0
      %>

      <article class="team-card">
        <header class="team-card-head">
          <div class="team-card-id">
            <span class="team-card-icon"><i class="bi bi-building"></i></span>
            <div>
              <h3><%= dept %></h3>
              <p><%= pluralize(stats.length, "month") %> tracked</p>
            </div>
          </div>
          <div class="team-rate">
            <strong><%= ontime_pct %>%</strong>
            <span>on-time rate</span>
          </div>
        </header>

        <div class="team-kpis">
          <div class="team-kpi tone-brand"><strong><%= total_ci %></strong><span>Clock-ins</span></div>
          <div class="team-kpi tone-good"><strong><%= total_ot %></strong><span>On time</span></div>
          <div class="team-kpi tone-bad"><strong><%= total_lt %></strong><span>Lates</span></div>
          <div class="team-kpi tone-warn"><strong><%= total_hd %></strong><span>Half days</span></div>
        </div>

        <% if most_late_user && most_late_count > 0 %>
          <div class="team-callout">
            <span class="team-callout-avatar"><%= most_late_user.name.to_s.split.first(2).map { |part| part[0] }.join.upcase %></span>
            <div class="team-callout-text">
              <strong><%= most_late_user.name %></strong>
              <span>late most often: <%= pluralize(most_late_count, "late arrival") %> in the last 12 months</span>
            </div>
            <span class="pill pill--rejected"><%= most_late_count %> lates</span>
          </div>
        <% end %>

        <div class="team-table-wrap">
          <table class="team-table">
            <thead>
              <tr>
                <th>Month</th>
                <th class="num">Clock-ins</th>
                <th class="num">On time</th>
                <th class="num">Lates</th>
                <th class="num">Half days</th>
              </tr>
            </thead>
            <tbody>
              <% stats.each do |stat| %>
                <% is_current = stat[:month].year == Date.current.year && stat[:month].month == Date.current.month %>
                <% ot_count = stat[:on_time] || (stat[:clock_ins] - stat[:lates]) %>
                <tr class="<%= 'is-current' if is_current %>">
                  <td>
                    <%= stat[:month].strftime("%b %Y") %>
                    <% if is_current %><span class="team-now">This month</span><% end %>
                  </td>
                  <%# Each numeric cell: an optional bar, then the figure in a fixed-width slot so the columns line up. %>
                  <td class="num">
                    <span class="team-bar tone-brand"><i style="width: <%= (stat[:clock_ins].to_f / max_ci * 100).round %>%"></i></span>
                    <b><%= stat[:clock_ins] %></b>
                  </td>
                  <td class="num"><b class="<%= 'is-zero' if ot_count.zero? %>"><%= ot_count.zero? ? "–" : ot_count %></b></td>
                  <td class="num">
                    <span class="team-bar tone-bad"><i style="width: <%= (stat[:lates].to_f / max_lates * 100).round %>%"></i></span>
                    <b class="<%= stat[:lates].zero? ? 'is-zero' : 'is-bad' %>"><%= stat[:lates] %></b>
                  </td>
                  <td class="num">
                    <span class="team-bar tone-warn"><i style="width: <%= (stat[:half_days].to_f / max_hd * 100).round %>%"></i></span>
                    <b class="<%= stat[:half_days].zero? ? 'is-zero' : 'is-warn' %>"><%= stat[:half_days].zero? ? "–" : stat[:half_days] %></b>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </article>
    <% end %>
  </div>
</section>
<% end %>
