<%# Live status of everyone below this manager. Refreshed in place every 15 seconds. %>
<div class="dashboard-container">
  <div class="particles" id="particles-js"></div>

  <div class="dashboard-glass">
    <%= render 'dashboard/header' %>

    <section class="home-section">
      <div class="dashboard-card" id="manager-status-container">
        <%= render 'dashboard/manager_executives_status' %>
      </div>
    </section>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    setInterval(function() {
      fetch('/dashboard/manager_status')
        .then(response => response.text())
        .then(html => {
          const container = document.getElementById('manager-status-container');
          if (container) {
            container.innerHTML = html;
          }
        })
        .catch(error => console.error("Error updating status:", error));
    }, 15000); // 15 seconds
  });
</script>
