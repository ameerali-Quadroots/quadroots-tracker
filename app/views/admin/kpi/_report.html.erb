<%#
  Late-arrival KPI report.
  Self-styled: the admin panel runs a custom ActiveAdmin theme with no Bootstrap.
%>
<%
  month_param = month.strftime("%Y-%m")
  flagged     = report.rows.count(&:kpi_deducted)
%>

<style>
  .kpi-report .kpi-bar { display:flex; flex-wrap:wrap; align-items:flex-end; gap:12px; margin-bottom:18px; }
  .kpi-report .kpi-bar label { display:block; font-size:0.72rem; font-weight:700; text-transform:uppercase;
    letter-spacing:0.5px; color:var(--qr-muted); margin-bottom:4px; }
  .kpi-report .kpi-bar input, .kpi-report .kpi-bar select { padding:8px 10px; border:1px solid #D4D0E0;
    border-radius:8px; background:#fff; font-size:0.88rem; min-width:170px; }
  .kpi-report .kpi-bar .kpi-export { margin-left:auto; }
  .kpi-report .kpi-rule { background:var(--qr-purple-50); border:1px solid var(--qr-line);
    border-left:4px solid var(--qr-purple); border-radius:8px; padding:10px 14px; font-size:0.86rem;
    color:var(--qr-ink); margin-bottom:18px; }
  .kpi-report table { width:100%; border-collapse:collapse; }
  .kpi-report th, .kpi-report td { padding:10px 14px; text-align:left; font-size:0.87rem;
    border-bottom:1px solid var(--qr-line); }
  .kpi-report thead th { background:var(--qr-purple-50); color:var(--qr-purple-darker); font-size:0.72rem;
    font-weight:700; text-transform:uppercase; letter-spacing:0.5px; }
  .kpi-report .kpi-num { text-align:right; font-variant-numeric:tabular-nums; }
  .kpi-report tfoot td { font-weight:700; border-bottom:0; }
  .kpi-report tr.kpi-flagged td { background:#FEF2F2; }
  .kpi-report .kpi-empty { padding:18px; color:var(--qr-muted); }
  .kpi-report .table-wrap { overflow-x:auto; }
</style>

<div class="kpi-report">
  <%= form_tag admin_kpi_path, method: :get, class: "kpi-bar" do %>
    <div>
      <label for="kpi_month">Month</label>
      <%= month_field_tag :month, month_param, id: "kpi_month" %>
    </div>
    <div>
      <label for="kpi_department">Department</label>
      <%= select_tag :department,
                     options_for_select(department_options, params[:department]),
                     include_blank: "All departments", id: "kpi_department" %>
    </div>
    <%= submit_tag "Apply", name: nil, class: "button" %>
    <%= link_to "Export Excel",
                admin_kpi_export_path(month: month_param, department: params[:department].presence),
                class: "button kpi-export" %>
  <% end %>

  <div class="kpi-rule">
    <strong><%= month.strftime("%B %Y") %>:</strong>
    KPI is deducted for anyone with more than <strong><%= report.limit %></strong> late
    <%= "arrival".pluralize(report.limit) %> in the month.
    <strong><%= flagged %></strong> of <%= report.rows.size %> <%= "employee".pluralize(report.rows.size) %> flagged.
  </div>

  <div class="panel">
    <h3>Department summary</h3>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Department</th>
            <th class="kpi-num">Total employees</th>
            <th class="kpi-num">Total lates</th>
            <th class="kpi-num">KPI deducted employees</th>
          </tr>
        </thead>
        <tbody>
          <% report.department_summary.each do |summary| %>
            <tr>
              <td><%= summary.department %></td>
              <td class="kpi-num"><%= summary.total_employees %></td>
              <td class="kpi-num"><%= summary.total_lates %></td>
              <td class="kpi-num"><%= summary.flagged_count %></td>
            </tr>
          <% end %>
        </tbody>
        <% if report.department_summary.any? %>
          <tfoot>
            <tr>
              <td>Total</td>
              <td class="kpi-num"><%= report.rows.size %></td>
              <td class="kpi-num"><%= report.rows.sum(&:late_count) %></td>
              <td class="kpi-num"><%= flagged %></td>
            </tr>
          </tfoot>
        <% end %>
      </table>
    </div>
    <% if report.department_summary.empty? %>
      <div class="kpi-empty">No employees in the departments you can view.</div>
    <% end %>
  </div>

  <div class="panel">
    <h3>Employees</h3>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Employee</th>
            <th>Department</th>
            <th>Shift time</th>
            <th class="kpi-num">Lates</th>
            <th class="kpi-num">Allowed</th>
            <th>KPI deducted</th>
          </tr>
        </thead>
        <tbody>
          <% report.rows.each do |row| %>
            <tr class="<%= 'kpi-flagged' if row.kpi_deducted %>">
              <td><%= row.user.name %></td>
              <td><%= row.department %></td>
              <td><%= row.user.shift_time&.strftime("%I:%M %p") %></td>
              <td class="kpi-num"><%= row.late_count %></td>
              <td class="kpi-num"><%= report.limit %></td>
              <td>
                <% if row.kpi_deducted %>
                  <span class="status_tag status-error">True</span>
                <% else %>
                  <span class="status_tag status-ok">False</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
