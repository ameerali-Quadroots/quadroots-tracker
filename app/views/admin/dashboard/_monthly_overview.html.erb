  <%
    current_year = Time.zone.now.year
    year = local_assigns[:year].presence&.to_i || current_year
    active_index = (year == current_year) ? (Time.zone.now.month - 1) : 11

    year_start = Time.new(year, 1).beginning_of_year
    year_end = Time.new(year, 12).end_of_year
    
    # Fetch all time clocks for the selected year in one query
    all_year_clocks = TimeClock.where(clock_in: year_start..year_end).select(:user_id, :status, :clock_in, :clock_out, :total_duration).to_a
    active_users = User.where(employeed: true).order(:name).to_a
    
    # An employee over the KPI late limit for the month is flagged, using the
    # same setting as the KPI page.
    late_limit = AppSetting.instance.late_kpi_monthly_limit
    initials = ->(name) { name.to_s.split.first(2).map { |part| part[0] }.join.upcase.presence || "?" }

    months = (1..12).to_a
    monthly_stats = months.map do |month_number|
      month_start = Time.new(year, month_number).beginning_of_month
      month_end   = Time.new(year, month_number).end_of_month
      
      month_clocks = all_year_clocks.select { |tc| tc.clock_in >= month_start && tc.clock_in <= month_end }
      on_time_count = month_clocks.count { |tc| tc.status == "on_time" }
      late_count    = month_clocks.count { |tc| tc.status == "late" }
      
      user_clocks_map = month_clocks.group_by(&:user_id)
      
      users_data = active_users.map do |user|
        u_clocks = user_clocks_map[user.id] || []
        u_on_time = u_clocks.count { |tc| tc.status == "on_time" }
        u_late = u_clocks.count { |tc| tc.status == "late" }
        total = u_on_time + u_late
        late_ratio = total > 0 ? ((u_late.to_f / total) * 100).round : 0
        
        # Calculate total duration in hours
        total_seconds = u_clocks.sum { |tc| tc.total_duration || 0 }
        total_hours = (total_seconds / 3600.0).round(1)
        
        # Calculate average clock-in time
        in_times = u_clocks.map(&:clock_in).compact
        avg_in_str = if in_times.any?
          avg_seconds = in_times.sum { |t| t.hour * 3600 + t.min * 60 + t.sec } / in_times.size
          avg_hour = avg_seconds / 3600
          avg_minute = (avg_seconds % 3600) / 60
          Time.zone.now.change(hour: avg_hour, min: avg_minute).strftime("%I:%M %p")
        else
          "N/A"
        end

        {
          user: user,
          on_time: u_on_time,
          late: u_late,
          total: total,
          late_ratio: late_ratio,
          total_hours: total_hours,
          avg_in: avg_in_str
        }
      end

      # Sort initially by most lates
      users_data = users_data.sort_by { |d| -d[:late] }

      {
        month_name: month_start.strftime("%B"),
        on_time: on_time_count,
        late: late_count,
        users_data: users_data
      }
    end
  %>

  <%# Styled by the DASHBOARD section of active_admin.scss (.db-*). Script hooks
      (see _super_admin_dashboard): #analytics-year-select, .dash-tab / #tab-N,
      .dash-tab-panel / #panel-N, #container-N, .monthly-row-item (+ data-*),
      .monthly-search-input, .monthly-dept-filter, .monthly-sort-select, #empty-N. %>
  <div class="db-card db-monthly">
    <div class="db-monthly-head">
      <div>
        <div class="db-card-title">Monthly overview</div>
        <div class="db-card-hint">On-time and late clock-ins for each month, with every employee's record</div>
      </div>
      <select id="analytics-year-select" aria-label="Year">
        <% current_year.downto(current_year - 2).each do |y| %>
          <option value="<%= y %>" <%= 'selected' if year == y %>><%= y %></option>
        <% end %>
      </select>
    </div>

    <% if monthly_stats.any? { |m| (m[:on_time] + m[:late]).positive? } %>
      <div class="db-monthly-chart" role="img" aria-label="On-time and late clock-ins per month in <%= year %>"
           data-chart="<%= { kind: "columns", stacked: true, height: 240, colors: ["#6F2B8A", "#E5484D"],
                categories: monthly_stats.map { |m| m[:month_name].first(3) },
                series: [{ name: "On time", data: monthly_stats.map { |m| m[:on_time] } },
                         { name: "Late", data: monthly_stats.map { |m| m[:late] } }] }.to_json %>"></div>
    <% end %>

    <div class="db-months tablist" role="tablist" aria-label="Month">
      <% monthly_stats.each_with_index do |data, index| %>
        <button type="button"
          class="dash-tab <%= 'active' if index == active_index %>"
          role="tab"
          aria-selected="<%= index == active_index %>"
          aria-controls="panel-<%= index %>"
          id="tab-<%= index %>"
          tabindex="<%= index == active_index ? 0 : -1 %>">
          <%= data[:month_name].first(3) %>
        </button>
      <% end %>
    </div>

    <div class="tab-panels">
      <% monthly_stats.each_with_index do |data, index| %>
        <section
          id="panel-<%= index %>"
          class="dash-tab-panel"
          role="tabpanel"
          aria-labelledby="tab-<%= index %>"
          aria-hidden="<%= index != active_index %>"
          <%= 'hidden' if index != active_index %>>

          <% month_total = data[:on_time] + data[:late] %>
          <div class="db-month-summary">
            <div class="db-month-stat">
              <span class="db-tile-icon db-tone-good"><i class="bi bi-check-circle-fill"></i></span>
              <div><strong><%= data[:on_time] %></strong><span>on time in <%= data[:month_name] %></span></div>
            </div>
            <div class="db-month-stat">
              <span class="db-tile-icon db-tone-bad"><i class="bi bi-clock-fill"></i></span>
              <div><strong><%= data[:late] %></strong><span>late in <%= data[:month_name] %></span></div>
            </div>
            <div class="db-month-stat">
              <span class="db-tile-icon db-tone-brand"><i class="bi bi-percent"></i></span>
              <div><strong><%= month_total.positive? ? "#{((data[:on_time] * 100.0) / month_total).round}%" : "–" %></strong><span>on-time rate</span></div>
            </div>
          </div>

          <div class="db-toolbar">
            <div class="db-search">
              <i class="bi bi-search"></i>
              <input type="text" class="monthly-search-input" data-month-index="<%= index %>" placeholder="Search employees" aria-label="Search employees">
            </div>
            <select class="monthly-dept-filter" data-month-index="<%= index %>" aria-label="Department">
              <option value="all">All departments</option>
              <% departments = data[:users_data].map { |s| s[:user].department }.compact.uniq.sort %>
              <% departments.each do |dept| %>
                <option value="<%= dept %>"><%= dept.upcase %></option>
              <% end %>
            </select>
            <select class="monthly-sort-select" data-month-index="<%= index %>" aria-label="Sort by">
              <option value="late-desc">Most lates</option>
              <option value="late-asc">Fewest lates</option>
              <option value="ratio-desc">Highest late rate</option>
              <option value="hours-desc">Most hours worked</option>
              <option value="on-time-desc">Most on time</option>
              <option value="name">Name</option>
            </select>
          </div>

          <div class="db-rows-head" aria-hidden="true">
            <span class="db-col-who">Employee</span>
            <span class="db-col-num">On time</span>
            <span class="db-col-num">Late</span>
            <span class="db-col-num">Hours</span>
            <span class="db-col-num">Average in</span>
            <span class="db-col-rate">Late rate</span>
            <span class="db-col-flag">Standing</span>
          </div>

          <div class="monthly-rows-container db-rows" id="container-<%= index %>">
            <% data[:users_data].each do |ud| %>
              <%
                user = ud[:user]
                late = ud[:late]
                on_time = ud[:on_time]
                late_ratio = ud[:late_ratio]
                total = ud[:total]
                total_hours = ud[:total_hours]
                avg_in = ud[:avg_in]
              %>
              <a href="<%= admin_employee_path(user) %>" class="monthly-row-item db-row" data-name="<%= user.name.to_s.downcase %>" data-dept="<%= user.department %>" data-late="<%= late %>" data-on-time="<%= on_time %>" data-ratio="<%= late_ratio %>" data-hours="<%= total_hours %>">
                <span class="db-col-who">
                  <span class="db-avatar db-avatar-sm"><%= initials.(user.name) %></span>
                  <span class="db-emp-id">
                    <span class="db-emp-name emp-name-link"><%= user.name %></span>
                    <span class="db-emp-meta"><%= user.department.presence || "No department" %></span>
                  </span>
                </span>
                <span class="db-col-num"><%= on_time %></span>
                <span class="db-col-num <%= 'db-num-bad' if late.positive? %>"><%= late %></span>
                <span class="db-col-num"><%= total_hours %> h</span>
                <span class="db-col-num"><%= avg_in == "N/A" ? "–" : avg_in %></span>
                <span class="db-col-rate">
                  <span class="db-rate-track"><i style="width: <%= late_ratio %>%"></i></span>
                  <span class="db-rate-text"><%= late_ratio %>%</span>
                </span>
                <span class="db-col-flag">
                  <% if late > late_limit %>
                    <span class="status_tag late">KPI deducted</span>
                  <% elsif total == 0 %>
                    <span class="status_tag off">No shifts</span>
                  <% else %>
                    <span class="status_tag ok">Good standing</span>
                  <% end %>
                </span>
              </a>
            <% end %>
          </div>

          <div id="empty-<%= index %>" class="db-rows-empty" style="display:none;">
            <strong>No employees match these filters</strong>
            Try a different name or department.
          </div>
        </section>
      <% end %>
    </div>
  </div>
