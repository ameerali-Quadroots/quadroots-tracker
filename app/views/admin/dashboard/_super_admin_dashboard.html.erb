<!-- 1. LIVE STATE & COMMAND CENTER -->
<%= render partial: "admin/dashboard/live_state_auto", locals: { departments: User.distinct.pluck(:department).compact.sort } %>

<%
  # === Define today's range (3 AM cutoff) ===
  now = Time.zone.now

  if now.hour < 3
    # Before 3 AM → treat as previous work day
    start_time = (now - 1.day).change(hour: 3)
    end_time = now.change(hour: 3)
  else
    # After 3 AM → treat as current day
    start_time = now.change(hour: 3)
    end_time = (now + 1.day).change(hour: 3)
  end

  # === Today's Summary ===
  @late_time_clocks = TimeClock.where(clock_in: start_time..end_time, status: 'late')
  @on_time_time_clocks = TimeClock.where(clock_in: start_time..end_time, status: 'on_time')

  @late_count = @late_time_clocks.count
  @on_time_count = @on_time_time_clocks.count
  @unique_late_users_today = @late_time_clocks.select(:user_id).distinct.count
%>

<div class="db db-history">

  <div class="db-section-head">
    <h2 class="db-section-title">Attendance history</h2>
    <p class="db-section-sub">Today's shift day is <%= start_time.strftime('%d %b %Y') %>. Each card opens the matching list.</p>
  </div>

  <div class="db-links">
    <a class="db-link db-tone-bad" href="<%= admin_time_clocks_url(q: {clock_in_gteq: start_time, clock_in_lteq: end_time, status_eq: 'late'}, commit: 'Filter', order: 'id_desc') %>">
      <span class="db-tile-icon"><i class="bi bi-clock-history"></i></span>
      <span class="db-link-text"><strong><%= @unique_late_users_today %></strong><span>Late today</span></span>
      <i class="bi bi-arrow-up-right db-link-go"></i>
    </a>
    <a class="db-link db-tone-good" href="<%= admin_time_clocks_url(q: {clock_in_gteq: start_time, clock_in_lteq: end_time, status_eq: 'on_time'}, commit: 'Filter', order: 'id_desc') %>">
      <span class="db-tile-icon"><i class="bi bi-check-circle-fill"></i></span>
      <span class="db-link-text"><strong><%= @on_time_count %></strong><span>On time today</span></span>
      <i class="bi bi-arrow-up-right db-link-go"></i>
    </a>
    <a class="db-link db-tone-brand" href="<%= admin_employees_url(scope: 'employed') %>">
      <span class="db-tile-icon"><i class="bi bi-person-check-fill"></i></span>
      <span class="db-link-text"><strong><%= User.where(employeed: true).count %></strong><span>Employed</span></span>
      <i class="bi bi-arrow-up-right db-link-go"></i>
    </a>
    <a class="db-link db-tone-mute" href="<%= admin_employees_url(scope: 'unemployed') %>">
      <span class="db-tile-icon"><i class="bi bi-person-dash-fill"></i></span>
      <span class="db-link-text"><strong><%= User.where(employeed: [false, nil]).count %></strong><span>No longer employed</span></span>
      <i class="bi bi-arrow-up-right db-link-go"></i>
    </a>
    <a class="db-link db-tone-brand" href="<%= admin_analytics_path %>">
      <span class="db-tile-icon"><i class="bi bi-graph-up-arrow"></i></span>
      <span class="db-link-text"><strong>Analytics</strong><span>Trends and breakdowns</span></span>
      <i class="bi bi-arrow-up-right db-link-go"></i>
    </a>
  </div>

  <!-- 3. MONTHLY ATTENDANCE TABS -->
  <div id="monthly-overview">
    <%= render partial: "admin/dashboard/monthly_overview", locals: { year: params[:analytics_year] } %>
  </div>


  <script>
    function initMonthlyOverview() {
      const tabs = Array.prototype.slice.call(document.querySelectorAll(".dash-tab"));
      const panels = Array.prototype.slice.call(document.querySelectorAll(".dash-tab-panel"));
      if (tabs.length === 0) return;

      // Show a single month panel and hide the rest. We toggle the `hidden`
      // attribute AND inline display so it works regardless of CSS load order.
      function showPanel(index) {
        tabs.forEach(t => {
          const on = (t.id === "tab-" + index);
          t.classList.toggle("active", on);
          t.setAttribute("aria-selected", on ? "true" : "false");
          t.tabIndex = on ? 0 : -1;
        });
        panels.forEach(p => {
          const on = (p.id === "panel-" + index);
          p.setAttribute("aria-hidden", on ? "false" : "true");
          if (on) {
            p.removeAttribute("hidden");
            p.style.display = "block";
          } else {
            p.setAttribute("hidden", "hidden");
            p.style.display = "none";
          }
        });
        applyMonthlyFilters(index); // keep the chosen search/dept/sort applied
      }

      tabs.forEach(tab => {
        tab.addEventListener("click", () => {
          showPanel(tab.id.replace("tab-", ""));
        });
      });

      // Client-side filtration & sorting logic for monthly trackers
      function applyMonthlyFilters(monthIndex) {
        const container = document.getElementById(`container-${monthIndex}`);
        if (!container) return;

        const searchInput = document.querySelector(`.monthly-search-input[data-month-index="${monthIndex}"]`);
        const deptFilter = document.querySelector(`.monthly-dept-filter[data-month-index="${monthIndex}"]`);
        const sortSelect = document.querySelector(`.monthly-sort-select[data-month-index="${monthIndex}"]`);

        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const deptVal = deptFilter ? deptFilter.value : 'all';
        const sortVal = sortSelect ? sortSelect.value : 'late-desc';

        const rows = Array.from(container.querySelectorAll('.monthly-row-item'));

        rows.forEach(row => {
          const name = row.getAttribute('data-name');
          const dept = row.getAttribute('data-dept');
          
          const matchSearch = name.includes(query);
          const matchDept = (deptVal === 'all' || dept === deptVal);

          if (matchSearch && matchDept) {
            row.style.display = 'flex';
          } else {
            row.style.display = 'none';
          }
        });

        const visibleRows = rows.filter(r => r.style.display !== 'none');
        const hiddenRows = rows.filter(r => r.style.display === 'none');

        visibleRows.sort((a, b) => {
          if (sortVal === 'name') {
            return a.getAttribute('data-name').localeCompare(b.getAttribute('data-name'));
          } else if (sortVal === 'late-desc') {
            return parseInt(b.getAttribute('data-late')) - parseInt(a.getAttribute('data-late'));
          } else if (sortVal === 'late-asc') {
            return parseInt(a.getAttribute('data-late')) - parseInt(b.getAttribute('data-late'));
          } else if (sortVal === 'ratio-desc') {
            return parseInt(b.getAttribute('data-ratio')) - parseInt(a.getAttribute('data-ratio'));
          } else if (sortVal === 'hours-desc') {
            return parseFloat(b.getAttribute('data-hours')) - parseFloat(a.getAttribute('data-hours'));
          } else if (sortVal === 'on-time-desc') {
            return parseInt(b.getAttribute('data-on-time')) - parseInt(a.getAttribute('data-on-time'));
          }
          return 0;
        });

        // Re-append to order them visually
        container.innerHTML = '';
        visibleRows.forEach(r => container.appendChild(r));
        hiddenRows.forEach(r => container.appendChild(r));

        // Toggle Empty State
        const emptyState = document.getElementById(`empty-${monthIndex}`);
        if (visibleRows.length === 0) {
          if (emptyState) emptyState.style.display = 'block';
        } else {
          if (emptyState) emptyState.style.display = 'none';
        }
      }

      // Attach dynamic events
      document.querySelectorAll('.monthly-search-input').forEach(input => {
        input.addEventListener('input', () => {
          applyMonthlyFilters(input.getAttribute('data-month-index'));
        });
      });

      document.querySelectorAll('.monthly-dept-filter').forEach(select => {
        select.addEventListener('change', () => {
          applyMonthlyFilters(select.getAttribute('data-month-index'));
        });
      });

      document.querySelectorAll('.monthly-sort-select').forEach(select => {
        select.addEventListener('change', () => {
          applyMonthlyFilters(select.getAttribute('data-month-index'));
        });
      });

      // Year selector — fetches just the Monthly Overview for the chosen year
      // over AJAX and swaps it in, instead of reloading the whole page.
      const yearSelect = document.getElementById("analytics-year-select");
      if (yearSelect) {
        yearSelect.addEventListener("change", function () {
          const year = this.value;
          const container = document.getElementById("monthly-overview");
          if (!container) return;

          container.style.opacity = "0.5";
          container.style.pointerEvents = "none";

          // Keep the address bar in sync so a manual refresh keeps the year,
          // without actually navigating.
          const u = new URL(window.location.href);
          u.searchParams.set("analytics_year", year);
          history.replaceState(null, "", u.toString());

          fetch("/admin/dashboard/monthly_overview?analytics_year=" + encodeURIComponent(year), {
            headers: { "X-Requested-With": "XMLHttpRequest" },
            credentials: "same-origin"
          })
            .then(r => r.ok ? r.text() : Promise.reject(r.status))
            .then(html => {
              container.innerHTML = html;
              container.style.opacity = "";
              container.style.pointerEvents = "";
              initMonthlyOverview(); // re-bind tabs / filters / year select on new markup
              if (window.qrRenderCharts) window.qrRenderCharts(); // the year chart in the new markup
            })
            .catch(() => {
              container.style.opacity = "";
              container.style.pointerEvents = "";
            });
        });
      }

      // Apply the default sort/filter to whichever month is active on load.
      const activeTab = document.querySelector(".dash-tab.active") || tabs[0];
      if (activeTab) showPanel(activeTab.id.replace("tab-", ""));
    }

    // Run now if the DOM is ready, otherwise wait. Using both paths means the
    // handlers attach even if DOMContentLoaded already fired (large page /
    // late-loading CDN scripts).
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initMonthlyOverview);
    } else {
      initMonthlyOverview();
    }
  </script>

</div>
