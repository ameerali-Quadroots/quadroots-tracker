<%# --- Per-employee shift windows -------------------------------------------
    Each employee has their own shift_time (mostly 18:00, a few 18:18 / 19:00)
    and may clock in up to 30 minutes early, so a single global 18:30 window
    silently dropped everyone who clocked in before 18:30 (counting them as
    Offline and excluding them from On Time / Late). We now bucket each user's
    clock against THEIR own shift cycle, mirroring TimeClocksController#clock_in.
    `anchor` is the date the current cycle started on (the evening shift runs
    past midnight to ~04:00, so before 4am we anchor to the previous day). %>
<%
  now = Time.zone.now
  anchor = now.hour < 4 ? (now - 1.day) : now
  default_shift = Time.zone.parse("18:00")
  win_starts = []   # actual shift starts, for the header display
  win_ends   = []
%>


<%# Markup is styled by the DASHBOARD section of active_admin.scss (.db-*).
    Hooks the scripts rely on, here and in _live_state_auto: #filter-dept,
    #filter-status, #employee-grid, #visible-count, .emp-card (+ data-*),
    .kpi-card[data-filter-status]. %>
<% if departments.empty? %>
  <div class="db-empty">
    <i class="bi bi-diagram-3"></i>
    No departments found to display.
  </div>
<% else %>
  <%
    all_states = []
    
    departments.each do |dept|
      users = User.includes(time_clocks: :breaks).where(department: dept, employeed: true)
      users.each do |user|
        st = user.shift_time || default_shift
        u_start = anchor.change(hour: st.hour, min: st.min, sec: 0)
        u_window = (u_start - 30.minutes)..(u_start + 9.hours)   # 30-min early grace, 9-hour shift
        win_starts << u_start
        win_ends   << (u_start + 9.hours)
        last_clock = user.time_clocks.where(clock_in: u_window).order(clock_in: :desc).first
        last_break = nil
        
        state = if last_clock.nil?
          "off"
        elsif last_clock.breaks.where(break_out: nil).exists?
          last_break = last_clock.breaks.where(break_out: nil).last
          case last_break.break_type
          when "Meeting" then "meeting"
          when "Downtime" then "downtime"
          else "on_break"
          end
        elsif last_clock.clock_out.nil?
          "working"
        else
          "off"
        end
        
        all_states << { 
          user: user, 
          dept: dept, 
          state: state, 
          last_clock: last_clock, 
          last_break: last_break 
        }
      end
    end

    total_users = all_states.size
    count_working = all_states.count { |s| s[:state] == "working" }
    count_break = all_states.count { |s| s[:state] == "on_break" }
    count_meeting = all_states.count { |s| s[:state] == "meeting" }
    count_downtime = all_states.count { |s| s[:state] == "downtime" }
    count_off = all_states.count { |s| s[:state] == "off" }

    # Today's attendance stats — one record per employee (their own shift-cycle
    # clock), so counts are distinct employees and respect each user's shift_time.
    attended = all_states.select { |s| s[:last_clock].present? }
    total_today_attendances = attended.size
    today_late_count    = attended.count { |s| s[:last_clock].status == 'late' }
    today_on_time_count = attended.count { |s| s[:last_clock].status == 'on_time' }
    late_ratio    = total_today_attendances > 0 ? ((today_late_count.to_f / total_today_attendances) * 100).round : 0
    on_time_ratio = total_today_attendances > 0 ? ((today_on_time_count.to_f / total_today_attendances) * 100).round : 0

    # Header display window spans the earliest shift start to the latest end.
    shift_start = win_starts.min || anchor.change(hour: default_shift.hour, min: default_shift.min, sec: 0)
    shift_end   = win_ends.max   || (shift_start + 9.hours)
  %>

  <%
    pct = ->(part, whole) { whole > 0 ? ((part.to_f / whole) * 100).round : 0 }
    initials = ->(name) { name.to_s.split.first(2).map { |part| part[0] }.join.upcase.presence || "?" }
    tiles = [
      { status: "all",      label: "Total team",    value: total_users,         icon: "people-fill",              tone: "brand" },
      { status: "working",  label: "Working now",   value: count_working,       icon: "briefcase-fill",           tone: "good" },
      { status: "on_time",  label: "On time today", value: today_on_time_count, icon: "check-circle-fill",        tone: "good" },
      { status: "late",     label: "Late today",    value: today_late_count,    icon: "clock-history",            tone: "bad" },
      { status: "on_break", label: "On break",      value: count_break,         icon: "cup-hot-fill",             tone: "warn" },
      { status: "meeting",  label: "In meeting",    value: count_meeting,       icon: "camera-video-fill",        tone: "info" },
      { status: "downtime", label: "Downtime",      value: count_downtime,      icon: "exclamation-triangle-fill", tone: "bad" },
      { status: "off",      label: "Offline",       value: count_off,           icon: "moon-stars-fill",          tone: "mute" }
    ]
    state_labels = { "working" => "Working", "on_break" => "On break", "meeting" => "Meeting", "downtime" => "Downtime", "off" => "Offline" }
  %>

  <div class="db">
    <%# ---- Headline: the floor right now ---- %>
    <section class="db-hero">
      <div class="db-hero-main">
        <div class="db-hero-live"><span class="db-live-dot"></span> Live, refreshes every 15 seconds</div>
        <h2 class="db-hero-title">Live Command Center</h2>
        <p class="db-hero-sub">
          <%= Time.zone.now.strftime("%A, %d %B") %>. Shift window <%= shift_start.strftime("%I:%M %p") %> to <%= shift_end.strftime("%I:%M %p") %>.
        </p>
      </div>
      <div class="db-hero-stats">
        <div class="db-hero-stat">
          <div class="db-hero-num"><%= count_working %><span>/ <%= total_users %></span></div>
          <div class="db-hero-label">working now</div>
          <div class="db-hero-meter"><i style="width: <%= pct.(count_working, total_users) %>%"></i></div>
        </div>
        <div class="db-hero-stat">
          <div class="db-hero-num"><%= on_time_ratio %><span>%</span></div>
          <div class="db-hero-label">on time today (<%= today_on_time_count %> of <%= total_today_attendances %>)</div>
          <div class="db-hero-meter"><i style="width: <%= on_time_ratio %>%"></i></div>
        </div>
        <div class="db-hero-stat">
          <div class="db-hero-num"><%= today_late_count %></div>
          <div class="db-hero-label">late today</div>
          <div class="db-hero-meter"><i style="width: <%= late_ratio %>%"></i></div>
        </div>
      </div>
    </section>

    <%# ---- Status tiles: each one filters the team list below ---- %>
    <div class="db-tiles">
      <% tiles.each do |tile| %>
        <div class="kpi-card db-tile db-tone-<%= tile[:tone] %>" data-filter-status="<%= tile[:status] %>" role="button" tabindex="0"
             title="Show <%= tile[:label].downcase %> in the list below">
          <span class="db-tile-icon"><i class="bi bi-<%= tile[:icon] %>"></i></span>
          <span class="db-tile-text">
            <span class="db-tile-value"><%= tile[:value] %></span>
            <span class="db-tile-label"><%= tile[:label] %></span>
          </span>
        </div>
      <% end %>
    </div>

    <div class="db-body">
      <aside class="db-side">
        <div class="db-card">
          <div class="db-card-title">Status right now</div>
          <div class="db-card-hint">Where the team is at this moment</div>
          <div role="img" aria-label="Team status breakdown"
               data-chart="<%= { kind: "donut", height: 270, total_label: "Team",
                    categories: ["Working", "On break", "Meeting", "Downtime", "Offline"],
                    colors: ["#16A34A", "#F59E0B", "#3B82F6", "#DC2626", "#A1A1AA"],
                    values: [count_working, count_break, count_meeting, count_downtime, count_off] }.to_json %>"></div>
        </div>

        <div class="db-card">
          <div class="db-card-title">Attendance today</div>
          <% if total_today_attendances.zero? %>
            <div class="db-card-empty">Nobody has clocked in for this shift yet.</div>
          <% else %>
            <div class="db-card-hint"><%= total_today_attendances %> clocked in for this shift</div>
            <div class="db-split" role="img" aria-label="<%= today_on_time_count %> on time, <%= today_late_count %> late">
              <i class="db-split-good" style="flex-grow: <%= today_on_time_count %>"></i>
              <i class="db-split-bad" style="flex-grow: <%= today_late_count %>"></i>
            </div>
            <div class="db-split-legend">
              <span><b class="db-dot db-dot-good"></b> On time <strong><%= today_on_time_count %></strong> <em><%= on_time_ratio %>%</em></span>
              <span><b class="db-dot db-dot-bad"></b> Late <strong><%= today_late_count %></strong> <em><%= late_ratio %>%</em></span>
            </div>
          <% end %>
        </div>

        <div class="db-card">
          <div class="db-card-title">Shift integrity</div>
          <div class="db-meters">
            <% [["Active workforce", pct.(count_working, total_users), "good", "#{pct.(count_working, total_users)}%"],
                ["On break or in a meeting", pct.(count_break + count_meeting, total_users), "warn", "#{pct.(count_break + count_meeting, total_users)}%"],
                ["Downtime", pct.(count_downtime, total_users), "bad", "#{count_downtime} active"]].each do |label, width, tone, text| %>
              <div class="db-meter">
                <div class="db-meter-row"><span><%= label %></span><strong><%= text %></strong></div>
                <div class="db-meter-track"><i class="db-fill-<%= tone %>" style="width: <%= width %>%"></i></div>
              </div>
            <% end %>
          </div>
        </div>
      </aside>

      <div class="db-main">
        <div class="db-card db-filters">
          <div class="db-filters-fields">
            <select id="filter-dept" aria-label="Department">
              <option value="all">All departments</option>
              <% departments.each do |d| %>
                <option value="<%= d %>"><%= d.upcase %></option>
              <% end %>
            </select>

            <select id="filter-status" aria-label="Status">
              <option value="all">All statuses</option>
              <option value="working">Working</option>
              <option value="on_time">On time (today)</option>
              <option value="late">Late (today)</option>
              <option value="on_break">On break</option>
              <option value="meeting">Meeting</option>
              <option value="downtime">Downtime</option>
              <option value="off">Offline</option>
            </select>
          </div>
          <div class="db-count">Showing <strong id="visible-count"><%= total_users %></strong> of <%= total_users %></div>
        </div>

        <div id="employee-grid" class="db-grid">
          <% all_states.sort_by { |s| [s[:state] == 'off' ? 1 : 0, s[:user].name] }.each do |item| %>
            <%
              user = item[:user]
              dept = item[:dept]
              state = item[:state]
              last_clock = item[:last_clock]
              last_break = item[:last_break]

              is_on_time = last_clock.present? && last_clock.status == 'on_time'
              is_late = last_clock.present? && last_clock.status == 'late'

              time_detail = case state
                when "working"
                  "In #{last_clock.clock_in.strftime('%I:%M %p')}"
                when "on_break", "meeting", "downtime"
                  "Since #{last_break&.break_in&.strftime('%I:%M %p') || 'N/A'}"
                else
                  last_clock&.clock_out.present? ? "Out #{last_clock.clock_out.strftime('%I:%M %p')}" : "Not clocked in"
                end
            %>

            <a href="<%= admin_employee_path(user) %>" class="emp-card db-emp db-state-<%= state %>" data-dept="<%= dept %>" data-status="<%= state %>" data-on-time="<%= is_on_time %>" data-late="<%= is_late %>">
              <div class="db-emp-top">
                <span class="db-avatar"><%= initials.(user.name) %><b class="db-avatar-dot"></b></span>
                <span class="db-emp-id">
                  <span class="db-emp-name emp-name-link"><%= user.name %></span>
                  <span class="db-emp-meta"><%= dept.upcase %>, <%= user.role || "Executive" %></span>
                </span>
              </div>
              <div class="db-emp-foot">
                <span class="db-emp-time">
                  <i class="bi bi-clock"></i> <%= time_detail %>
                  <% if is_late %><span class="db-late-flag">late</span><% end %>
                </span>
                <span class="status_tag <%= state %>"><%= state_labels[state] %></span>
              </div>
            </a>
          <% end %>
          <div id="employee-empty" class="db-grid-empty" hidden>No one matches these filters.</div>
        </div>
      </div>
    </div>

    <script>
      (function () {
        // Draw (or redraw after a live refresh) the charts in this partial.
        if (window.qrRenderCharts) window.qrRenderCharts();

        var deptFilter = document.getElementById("filter-dept");
        var statusFilter = document.getElementById("filter-status");
        var cards = document.querySelectorAll(".emp-card");
        var visibleCount = document.getElementById("visible-count");
        var empty = document.getElementById("employee-empty");
        var tiles = document.querySelectorAll("[data-filter-status]");

        function filterCards() {
          var dVal = deptFilter ? deptFilter.value : "all";
          var sVal = statusFilter ? statusFilter.value : "all";
          var count = 0;

          cards.forEach(function (card) {
            var matchDept = (dVal === "all" || card.getAttribute("data-dept") === dVal);

            var matchStatus;
            if (sVal === "all") {
              matchStatus = true;
            } else if (sVal === "on_time") {
              matchStatus = (card.getAttribute("data-on-time") === "true");
            } else if (sVal === "late") {
              matchStatus = (card.getAttribute("data-late") === "true");
            } else {
              matchStatus = (card.getAttribute("data-status") === sVal);
            }

            if (matchDept && matchStatus) {
              card.style.display = "flex";
              count++;
            } else {
              card.style.display = "none";
            }
          });

          if (visibleCount) visibleCount.textContent = count;
          if (empty) empty.hidden = count !== 0;
          // The tile matching the status filter stays lit, so it is clear what is being shown.
          tiles.forEach(function (tile) {
            tile.classList.toggle("is-active", tile.getAttribute("data-filter-status") === sVal);
          });
        }

        if (deptFilter && statusFilter) {
          deptFilter.addEventListener("change", filterCards);
          statusFilter.addEventListener("change", filterCards);
        }

        // Clicking a status tile filters the list to that status.
        tiles.forEach(function (tile) {
          function pick() {
            if (!statusFilter) return;
            statusFilter.value = tile.getAttribute("data-filter-status");
            filterCards();
          }
          tile.addEventListener("click", pick);
          tile.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " ") { e.preventDefault(); pick(); }
          });
        });

        filterCards();
      })();
    </script>
  </div>
<% end %>
