<%= render "tasks/head" %>

<% done, total = @sprint.progress %>
<% pct = total.zero? ? 0 : (done * 100.0 / total).round %>
<% logged = @sprint.logged_seconds %>
<% over_sla = @sprint.tasks.select(&:over_sla?).size %>

<div class="tm" data-tm-view="sprint">
  <div class="tm__inner">

    <header class="tm-head">
      <div>
        <nav class="tm-crumb" aria-label="Breadcrumb">
          <%= link_to "Task Manager", dashboard_tasks_path %>
          <span aria-hidden="true">/</span>
          <%= link_to "Sprints", dashboard_tasks_path(tab: "sprints") %>
          <span aria-hidden="true">/</span>
          <%= @sprint.project.client.name %>
          <span aria-hidden="true">/</span>
          <%= @sprint.project.name %>
        </nav>
        <h1 class="tm-head__title">
          <%= @sprint.name %>
          <span class="tm-badge tm-badge--<%= @sprint.status %>"><%= @sprint.status.humanize %></span>
        </h1>
        <p class="tm-head__sub">
          <%= @sprint.goal.presence || "No goal set for this cycle." %>
          <span class="tm-muted">
            · <%= @sprint.start_date.strftime("%d %b") %> to <%= @sprint.end_date.strftime("%d %b %Y") %>
          </span>
        </p>
      </div>
      <div class="tm-head__actions">
        <%= link_to "See in the task list", dashboard_tasks_path(sprint_id: @sprint.id), class: "tm-btn" %>
        <button type="button" class="tm-btn" data-bs-toggle="modal" data-bs-target="#tm-carry-over-modal">
          Carry over unfinished
        </button>
        <button type="button" class="tm-btn tm-btn--primary" data-bs-toggle="modal" data-bs-target="#tm-new-task-modal">
          <i class="fa-solid fa-plus" aria-hidden="true"></i>New task
        </button>
      </div>
    </header>

    <section class="tm-hero" aria-label="Sprint summary">
      <div class="tm-hero__lead">
        <p class="tm-hero__label">Logged in this sprint</p>
        <strong class="tm-hero__figure" data-numeric>
          <% h, rem = logged.divmod(3600) %>
          <%= h %><small>h</small> <%= rem / 60 %><small>m</small>
        </strong>
      </div>

      <div class="tm-ledger">
        <div class="tm-ledger__item">
          <span class="tm-ledger__label">Progress</span>
          <span class="tm-ledger__value" data-numeric><%= pct %>%</span>
          <span class="tm-ledger__note"><%= done %> of <%= total %> tasks done</span>
        </div>
        <div class="tm-ledger__item">
          <span class="tm-ledger__label">Still open</span>
          <span class="tm-ledger__value" data-numeric><%= total - done %></span>
          <span class="tm-ledger__note">in this cycle</span>
        </div>
        <div class="tm-ledger__item">
          <span class="tm-ledger__label">
            <% if over_sla.positive? %>
              <i class="fa-solid fa-triangle-exclamation" aria-hidden="true" style="color: var(--tm-critical)"></i>
            <% end %>
            Over budget
          </span>
          <span class="tm-ledger__value <%= over_sla.positive? ? 'tm-ledger__value--alert' : 'tm-ledger__value--muted' %>" data-numeric>
            <%= over_sla %>
          </span>
          <span class="tm-ledger__note">tasks past their SLA</span>
        </div>
      </div>
    </section>

    <%# The board takes the full width: four columns sharing the row with a side
        panel squeezed them under their minimum and cut the last one off. %>
    <section class="tm-panel">
      <div class="tm-panel__head">
        <h2 class="tm-panel__title">Board</h2>
        <p class="tm-panel__sub">Open a card to read the task and its comments</p>
      </div>
      <div class="tm-panel__body">
        <div class="tm-board">
          <% TasksHelper::STATUS_ROLES.each do |status, role| %>
            <section class="tm-col" data-status="<%= status %>">
              <header class="tm-col__head">
                <span class="tm-key tm-key--<%= status %>"></span>
                <h3 class="tm-col__title"><%= role[:label] %></h3>
                <span class="tm-seg__count"><%= @by_status[status].size %></span>
              </header>
              <div class="tm-col__body">
                <% if @by_status[status].empty? %>
                  <p class="tm-sub" style="text-align: center; padding: 0.75rem 0">Nothing here</p>
                <% else %>
                  <% @by_status[status].each do |task| %>
                    <%= render "tasks/task_card", task: task %>
                  <% end %>
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      </div>
    </section>

    <section class="tm-panel" style="margin-top: 1.25rem">
      <div class="tm-panel__head">
        <div>
          <h2 class="tm-panel__title">Who worked on it</h2>
          <p class="tm-panel__sub">Hours logged in this cycle, subtasks included</p>
        </div>
      </div>
      <div class="tm-panel__body">
        <% if @hours_by_user.empty? %>
          <p class="tm-muted">No time logged in this sprint yet.</p>
        <% else %>
          <ul class="tm-people tm-people--spread">
            <% @hours_by_user.sort_by { |_id, secs| -secs }.each do |user_id, seconds| %>
              <li>
                <span class="tm-who">
                  <%= task_avatar(@people[user_id]) %><%= @people[user_id]&.name || "Unknown" %>
                </span>
                <span class="tm-people__hours"><%= hours_label(seconds) %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </section>

  </div>
</div>

<%= render "tasks/drawer_shell" %>
<%= render "tasks/new_task_modal" %>
<%= render "tasks/task_edit_modal" %>

<div class="modal fade tm-modal" id="tm-carry-over-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <%= form_with url: carry_over_sprint_path(@sprint), method: :post, local: true,
                    html: { data: { turbo: false } } do %>
        <div class="modal-header">
          <h2 class="modal-title">Carry over unfinished work</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="tm-muted">
            Every task in <strong><%= @sprint.name %></strong> that isn't done moves to the sprint you
            pick. Completed tasks stay here, so this cycle keeps its record.
          </p>
          <% others = @sprints.reject { |s| s.id == @sprint.id } %>
          <% if others.empty? %>
            <p class="tm-muted">There is no other sprint to move work into yet.</p>
          <% else %>
            <div class="tm-field">
              <label class="tm-field__label" for="tm-carry-target">Move them to</label>
              <select name="target_sprint_id" id="tm-carry-target" class="tm-select" required>
                <% others.each do |sprint| %>
                  <option value="<%= sprint.id %>"><%= sprint_label(sprint) %></option>
                <% end %>
              </select>
            </div>
          <% end %>
        </div>
        <div class="modal-footer">
          <button type="button" class="tm-btn" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="tm-btn tm-btn--primary" <%= "disabled" if @sprints.reject { |s| s.id == @sprint.id }.empty? %>>
            Move the tasks
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
