<%# Top navigation for signed-in employees. The entries come from
    NavbarHelper#primary_nav_items; styles live in _app_navbar.scss. %>
<nav class="navbar navbar-expand-xl app-navbar sticky-top">
  <div class="container-fluid app-navbar-inner">
    <%= link_to root_path, class: "navbar-brand app-brand" do %>
      <span class="app-brand-mark"><%= image_tag "logo-2.png", alt: "" %></span>
      <span class="app-brand-name">QuadRoots Tracker</span>
    <% end %>

    <button class="navbar-toggler app-navbar-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <i class="fas fa-bars"></i>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav app-nav">
        <% primary_nav_items.each do |item| %>
          <% active = nav_item_active?(item) %>
          <% badge = capture do %>
            <% if item.badge.to_i.positive? %>
              <span class="nav-badge nav-badge-<%= item.badge_tone %>"><%= item.badge %></span>
            <% end %>
          <% end %>

          <% if item.dropdown? %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle <%= 'active' if active %>" href="#" role="button"
                 data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-<%= item.icon %>"></i> <%= item.label %> <%= badge %>
              </a>
              <ul class="dropdown-menu app-menu">
                <% item.children.each do |child| %>
                  <li>
                    <%= link_to child.path, class: "dropdown-item #{'active' if current_page?(child.path)}" do %>
                      <i class="fas fa-<%= child.icon %>"></i> <%= child.label %>
                      <% if child.badge.to_i.positive? %>
                        <span class="nav-badge nav-badge-<%= child.badge_tone %>"><%= child.badge %></span>
                      <% end %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </li>
          <% else %>
            <li class="nav-item">
              <%= link_to item.path, class: "nav-link #{'active' if active}",
                          target: (item.external ? "_blank" : nil), rel: (item.external ? "noopener" : nil),
                          aria: { current: (active ? "page" : nil) } do %>
                <i class="fas fa-<%= item.icon %>"></i> <%= item.label %> <%= badge %>
              <% end %>
            </li>
          <% end %>
        <% end %>
      </ul>

      <ul class="navbar-nav app-nav-tools">
        <%# NOTE: these three entries are static placeholders, not real notifications. %>
        <li class="nav-item dropdown">
          <a class="nav-link nav-icon-link" href="#" id="notificationDropdown" role="button"
             data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
            <i class="fas fa-bell"></i>
          </a>
          <ul class="dropdown-menu dropdown-menu-end app-menu notification-menu" aria-labelledby="notificationDropdown">
            <li><h6 class="dropdown-header">Notifications</h6></li>
            <li><a class="dropdown-item" href="#"><i class="fas fa-edit text-info"></i> Edit request approved</a></li>
            <li><a class="dropdown-item" href="#"><i class="fas fa-calendar-alt text-warning"></i> Leave request pending</a></li>
            <li><a class="dropdown-item" href="#"><i class="fas fa-check-circle text-success"></i> Profile updated</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item text-center" href="#">View All</a></li>
          </ul>
        </li>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle user-dropdown-toggle" href="#" id="userDropdown" role="button"
             data-bs-toggle="dropdown" aria-expanded="false">
            <span class="user-avatar">
              <% if current_user.image.attached? %>
                <%= image_tag current_user.image, alt: "" %>
              <% else %>
                <%= current_user.initials %>
              <% end %>
            </span>
            <span class="user-name"><%= current_user.name %></span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end app-menu" aria-labelledby="userDropdown">
            <li><h6 class="dropdown-header">Account</h6></li>
            <li>
              <%= link_to edit_user_path(current_user), class: "dropdown-item" do %>
                <i class="fas fa-user-edit"></i> Edit Profile
              <% end %>
            </li>
            <li>
              <%= link_to my_requests_edit_requests_path, class: "dropdown-item" do %>
                <i class="fas fa-history"></i> My Requests
              <% end %>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" do %>
                <i class="fas fa-sign-out-alt"></i> Logout
              <% end %>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>
