<div class="page-shell">
  <div class="table-card">

    <!-- Header -->
    <div class="table-card__head">
      <h1 class="table-card__title">
        <span class="icon"><i class="fas fa-calendar-check"></i></span>
        <span>
          Leave Requests
          <span class="table-card__subtitle">Review and respond to your team's leave requests</span>
        </span>
      </h1>
      <div class="table-card__stats">
        <span class="stat-pill"><b><%= @leaves.count %></b> Total</span>
        <span class="stat-pill"><b><%= @leaves.select { |l| l.status == "pending" }.size %></b> Pending</span>
        <span class="stat-pill"><b><%= @leaves.select { |l| l.status == "approved" }.size %></b> Approved</span>
      </div>
    </div>

    <!-- Table -->
    <% if @leaves.any? %>
      <div class="premium-table-wrap">
        <table class="premium-table">
          <thead>
            <tr>
              <th>Employee</th>
              <th>Leave Type</th>
              <th>Start Date</th>
              <th>End Date</th>
              <th>Reason</th>
              <th>Status</th>
              <th>Requested At</th>
              <th>Resolved At</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @leaves.each do |leave| %>
              <tr>
                <td>
                  <div class="user-cell">
                    <div class="user-cell__avatar"><%= leave.user.name.to_s.split.map(&:first).join[0, 2].upcase %></div>
                    <div>
                      <div class="user-cell__name"><%= leave.user.name %></div>
                      <div class="user-cell__email"><%= leave.user.email %></div>
                    </div>
                  </div>
                </td>
                <td><span class="type-tag text-capitalize"><%= leave.leave_type %></span></td>
                <td><div class="date-cell"><div class="d"><%= leave.start_date.strftime("%b %d, %Y") %></div></div></td>
                <td><div class="date-cell"><div class="d"><%= leave.end_date.strftime("%b %d, %Y") %></div></div></td>
                <td><div class="reason-cell"><%= leave.reason %></div></td>
                <td><span class="pill pill--<%= leave.status %>"><%= leave.status.capitalize %></span></td>
                <td>
                  <div class="date-cell">
                    <div class="d"><%= leave.created_at.strftime("%b %d, %Y") %></div>
                    <div class="t"><%= leave.created_at.strftime("%I:%M %p") %></div>
                  </div>
                </td>
                <td>
                  <div class="date-cell">
                    <div class="d"><%= leave.updated_at.strftime("%b %d, %Y") %></div>
                    <div class="t"><%= leave.updated_at.strftime("%I:%M %p") %></div>
                  </div>
                </td>
                <td>
                  <%# Approve only shows for whoever the chain is currently waiting on; reject
                      is offered on the same condition, since either action settles this step. %>
                  <% if leave.actionable_by?(current_user) %>
                    <div class="table-actions">
                      <%= button_to approve_leave_path(leave), method: :patch, class: "btn-act btn-act--approve", data: { turbo: false } do %>
                        <i class="fas fa-check"></i> Approve
                      <% end %>
                      <%= button_to reject_leave_path(leave), method: :patch, class: "btn-act btn-act--reject", data: { turbo: false } do %>
                        <i class="fas fa-times"></i> Reject
                      <% end %>
                    </div>
                  <% elsif leave.current_step %>
                    <span class="no-action">
                      With <%= leave.current_step.admin_step? ? "the admin team" : (leave.current_approver&.name || leave.current_step.to_s) %>
                    </span>
                  <% else %>
                    <span class="no-action">No actions</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="table-empty">
        <i class="bi bi-calendar-x"></i>
        <h5>No leave requests found</h5>
        <p class="mb-0">Leave requests from your team will appear here.</p>
      </div>
    <% end %>

  </div>
</div>
